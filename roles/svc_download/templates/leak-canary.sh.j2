#!/usr/bin/env bash
{% set restart_parts = [] %}
{% for app_name in download_apps %}{% set _ = restart_parts.append('dl-' ~ app_name ~ '.service') %}{% endfor %}
{% set restart_cmd = restart_parts | join(' ') %}
# leak-canary.sh — continuous verification of the jail invariants.
# RENDERED BY ANSIBLE from roles/svc_download/templates/leak-canary.sh.j2.
# Run by leak-canary.timer every 15 min. Converts "we leak-tested it once in
# July" into an enforced property.
#
# v5 fixes over v4:
#   - Checks an EXPLICIT expected list, not `podman ps` output. v4 iterated
#     only RUNNING containers, so "everything stopped" reported OK — and
#     since fail() stops the stack, one leak produced one alert and then
#     green forever.
#   - A leak writes a persistent tripped flag ($FLAG); every
#     subsequent run keeps alerting until you clear it:
#         rm /var/lib/leak-canary/tripped && systemctl start {{ restart_cmd }}
#   - Alerts actually fire (ntfy on the LAN — host-backstop opens that path).
#   - Planned maintenance: `systemctl stop leak-canary.timer` first, or the
#     "service not active" alert will ping you.
#
# Severity model:
#   LEAK  (wrong netns / foreign route / wrong egress IP)  -> stop stack,
#         write flag, urgent alert, exit 1.
#   DOWN  (expected container missing / unit inactive)     -> high alert,
#         exit 1, NO stop (nothing to protect) and NO flag.
#   A stalled egress curl (tunnel down) is NOT a failure — fail-closed working.
set -uo pipefail

STATE_DIR=/var/lib/leak-canary
FLAG="$STATE_DIR/tripped"
# Consecutive runs in which the egress IDENTITY could not be established. Not
# a leak — see section 3 — but a number that only grows means the one check
# that proves whose exit node we are using has silently stopped working.
UNVERIFIED="$STATE_DIR/egress-unverified"
UNVERIFIED_LIMIT={{ leak_canary_egress_unverified_limit | default(8) }}
# NTFY_ALERT_TOPIC, not NTFY_TOPIC. NTFY_TOPIC is homelab-deploy — the routine
# feed that carries every deploy notice and is subscribed muted. This script
# publishes the loudest message in the estate ("LEAK: download jail — download
# stack STOPPED", priority urgent) and it was going to the muted topic: ntfy
# would return 200, the journal would record a successful send, and the phone
# would stay silent. The fallback exists only so a host whose
# /etc/homelab-notify.env predates NTFY_ALERT_TOPIC still delivers somewhere.
topic="${NTFY_ALERT_TOPIC:-${NTFY_TOPIC}}"
NTFY="${NTFY_URL}/${topic}"
AUTH=()
if [[ -n "${NTFY_TOKEN:-}" ]]; then
    AUTH=(-H "Authorization: Bearer ${NTFY_TOKEN}")
fi
expected=({% for app_name in download_apps %}{{ app_name | quote }} {% endfor %})

mkdir -p "$STATE_DIR"

alert() {  # $1=priority $2=title $3=body — best effort, never gates logic
    logger -p auth.crit -t leak-canary "$2 — $3"
    curl -fsS --max-time 5 -X POST \
        -H "Title: $2" -H "Priority: $1" -H "Tags: rotating_light" \
        "${AUTH[@]}" \
        -d "$3" "$NTFY" >/dev/null 2>&1 \
        || logger -p auth.crit -t leak-canary "ALERT DELIVERY FAILED (ntfy unreachable): $2"
}

fail_leak() {
    date -Is > "$FLAG"
    systemctl stop 'dl-*.service' 2>/dev/null
    alert urgent "LEAK: download jail" "$1 — download stack STOPPED. Investigate, then: rm $FLAG && systemctl start {{ restart_cmd }}"
    exit 1
}

down() {
    alert high "download stack degraded" "$1 (planned maintenance? stop leak-canary.timer to silence)"
    exit 1
}

# 0. A previously-tripped canary stays loud until a human clears it.
if [[ -f "$FLAG" ]]; then
    alert high "download stack HALTED (leak flag)" "tripped $(cat "$FLAG"); still halted. Investigate, then rm $FLAG and restart dl-* units."
    exit 1
fi

# 1. Every expected container must exist, its unit must be active, and it
#    must live in the jail. Membership is proven by the main PID's netns
#    inode: SandboxKey is EMPTY for containers joined to a pre-made netns
#    via --network=ns: (podman only fills it for netns it created), so it
#    cannot distinguish "in the jail" from "drifted".
want_inode=$(stat -Lc %i /run/netns/vpn) || fail_leak "netns /run/netns/vpn missing"

# Read a container's network-namespace inode, or fail if it has no running
# process. The pid and the stat MUST be read together: they are two syscalls
# against a moving target, and a container that restarts between them leaves a
# stale pid whose /proc entry is already gone.
#
# That race used to stop the entire stack. The pid read had a retry; the stat
# that consumed it did not, so `stat` returned nothing, the comparison against
# want_inode failed, and the script reported "container X is NOT in the vpn
# netns" — writing the tripped flag and demanding manual clearance for a
# container that had merely been restarted.
container_ns_inode() {   # $1=container; prints the inode, or returns 1
    local pid
    pid=$(podman inspect -f '{% raw %}{{.State.Pid}}{% endraw %}' "$1" 2>/dev/null || true)
    [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 0 ]] || return 1
    stat -Lc %i /proc/"$pid"/ns/net 2>/dev/null || return 1
}

for c in "${expected[@]}"; do
    podman container exists "$c" \
        || down "expected container $c does not exist"
    systemctl is-active --quiet "dl-$c.service" \
        || down "dl-$c.service is not active"

    # Retry the PAIR, not just the pid.
    inode=$(container_ns_inode "$c") || { sleep 2; inode=$(container_ns_inode "$c" || true); }

    if [[ -z "$inode" ]]; then
        # No running process, twice. A container that is not running cannot be
        # leaking, so this is DOWN, not LEAK: alert, do not stop the stack, do
        # not write the flag. Getting this severity wrong is expensive in both
        # directions — halting on a restart trains people to clear the flag
        # without reading it.
        down "container $c has no running process (checked twice) — restarting or crashed"
    elif [[ "$inode" != "$want_inode" ]]; then
        # A DIFFERENT namespace. This is the real breach: the process is
        # running and its traffic is not going through the jail.
        fail_leak "container $c is in netns inode ${inode}, not the jail's ${want_inode}"
    fi
done

# 2. Topology drift.
ip -n vpn route show default | grep -q 'dev wg0' \
    || fail_leak "default route in netns is no longer wg0"
ip -n vpn route show | grep -Ev 'dev (lo|wg0|veth-vpn)' | grep -q . \
    && fail_leak "unexpected route present in netns"

# 3. Egress identity. THREE outcomes, and conflating two of them halted the
#    whole download stack for ~2.5h overnight on 2026-07-24.
#
#    The old test was `curl -s` with no `-f`, so an HTTP ERROR PAGE came back
#    as a successful fetch: am.i.mullvad.net served a 502 from its own nginx,
#    the body was non-empty and did not contain the magic string, and that was
#    read as "NOT Mullvad" — a leak. It was not a leak. It was Mullvad's status
#    page having a bad night.
#
#    An HTTP error is not a foreign-IP disclosure, so the status code is now
#    read separately from the body:
#      200 + "connected to Mullvad"  -> verified
#      200 + anything else           -> REAL leak; the endpoint answered and
#                                       told us we are not on Mullvad
#      anything else (incl. 000)     -> INCONCLUSIVE; we learned nothing
#
#    Inconclusive is safe to tolerate, but only because of what sections 1 and
#    2 already proved: every container is inside the jail and the jail's only
#    route is wg0. Traffic that cannot be identified also cannot escape — it
#    fails closed. What inconclusive is NOT is good news, so it is counted, and
#    a run of them alerts: an identity check that can never succeed has stopped
#    being a check, which is this repo's most-repeated failure.
egress_body=$(mktemp 2>/dev/null || true)
egress_code=000
if [[ -n "$egress_body" ]]; then
    egress_code=$(ip netns exec vpn curl -4 -s -o "$egress_body" -w '%{http_code}' \
        --max-time 10 https://am.i.mullvad.net/connected 2>/dev/null || echo 000)
    # Bounded and single-line: this string reaches an ntfy body and a log line,
    # and an HTML error page would otherwise paste a screenful into both.
    egress_text=$(tr -d '\r\n' < "$egress_body" 2>/dev/null | head -c 160)
    rm -f "$egress_body"
else
    egress_text=""
fi

if [[ "$egress_code" == "200" ]]; then
    if [[ "$egress_text" == *"You are connected to Mullvad"* ]]; then
        rm -f "$UNVERIFIED"
        logger -t leak-canary "OK (egress verified Mullvad)"
        exit 0
    fi
    fail_leak "egress endpoint answered 200 and does NOT report Mullvad: ${egress_text}"
fi

# Inconclusive. Count consecutive occurrences; alert once the run is long
# enough that a transient upstream outage is no longer the likely explanation.
# The timer fires every 15 minutes, so the default 8 is two hours — long
# enough to ride out a status-page blip, short enough that a permanently
# broken check surfaces the same day.
unverified=$(( $(cat "$UNVERIFIED" 2>/dev/null || echo 0) + 1 ))
if printf '%s\n' "$unverified" > "${UNVERIFIED}.tmp" 2>/dev/null; then
    mv -f "${UNVERIFIED}.tmp" "$UNVERIFIED" 2>/dev/null || rm -f "${UNVERIFIED}.tmp"
fi

logger -t leak-canary \
    "egress UNVERIFIED (http=${egress_code}, consecutive=${unverified}) — jail intact, identity unknown"

if (( unverified >= UNVERIFIED_LIMIT )); then
    alert high "download jail egress UNVERIFIED" \
"The jail is intact — every container is in the vpn netns and wg0 is still the only route, so traffic cannot escape.
What has stopped working is the check that proves WHOSE exit node we are using: ${unverified} consecutive runs could not reach a verdict (last HTTP ${egress_code}).
This is not a leak. It is the leak check going blind. Verify by hand:
  ip netns exec vpn curl -4 -sS -o /dev/null -w '%{http_code}\\n' https://am.i.mullvad.net/connected"
    exit 1
fi

exit 0
