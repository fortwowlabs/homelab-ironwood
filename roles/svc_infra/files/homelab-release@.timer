# Enabled for the runner account by roles/svc_infra/tasks/verify-runner.yml:
#   systemctl enable --now homelab-release@svcops.timer
[Unit]
Description=Run the homelab-iac weekly upstream release report for %i

[Timer]
# WEEKLY, Monday 08:30. Both halves are deliberate.
#
# Weekly because that is the cadence at which release news is actionable. Daily
# would report the same eighteen behind-images every morning until somebody
# stopped reading it, and this repo has already written down what happens to a
# channel that carries an expected non-zero number every day.
#
# 08:30 sits in a gap. The estate's scheduled work is 03:05/03:10/03:40 (per-VM
# appdata backups), 04:00 (nightly verify), 04:40 (backup freshness), 05:30
# (security scan, ~10 minutes longer on Sundays for the OpenSCAP benchmark),
# 06:30 (PVE health), 07:00 (svc-media's healthchecks.io heartbeat, +600s
# jitter), 08:00 Monday (the ntfy alert canary) and 09:15 (certwatch). A run
# measured at 63s starting at 08:30 is clear of all of them.
#
# Monday, because a report is worth exactly as much as the chance somebody reads
# it, and Monday morning is when this estate gets looked at. The alert canary
# records the same reasoning for the same slot.
#
# THE COUNTER-ARGUMENT, which that file also states: "two weekly checks on one
# day means one bad night can take out both". It is accepted here rather than
# dodged. The two share only this host and ntfy, they are half an hour apart,
# and unlike the canary this is informational — a missed week costs a week of
# unread release notes, not a week of undetected silence. Landing on the morning
# it gets read is worth more than the independence.
OnCalendar=Mon *-*-* 08:30:00
# Persistent, so a host powered off on Monday morning reports when it comes back
# rather than skipping the week. The report is a delta against the last run, so
# a late run loses nothing — it covers the whole gap.
Persistent=true
# RandomizedDelaySec, unlike the alert canary, which deliberately has none. The
# canary's fixed arrival time is what makes "it has not come" a judgement anyone
# can make. Nobody makes that judgement about a report, and 45 GitHub API
# requests against a 60/hour budget is worth keeping away from any other run
# that might share the address.
RandomizedDelaySec=600
# No OnBootSec. A reboot must not mint an extra report, or the weekly cadence
# stops carrying information and the delta gets split across two messages.

[Install]
WantedBy=timers.target
