    {
      "type": "timeseries",
      "title": "Age of each published file",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 33 },
      "fieldConfig": {
        "defaults": {
