# Nightly end-to-end proof that in-chat image generation still works.
# The instance is the unprivileged account owning the checkout:
#   systemctl start homelab-image-gen@svcops.service
#
# Separate from homelab-verify@ because it answers a different question and
# has a different failure meaning: a red verify means the estate drifted, a red
# image-gen means one application stopped functioning while every container
# stayed green. That is the exact failure this check exists to catch, so
# collapsing it into verify would bury it.
# That separation is enforced: svc-infra's verify failed-units gate exempts
# homelab-image-gen@* and homelab-image-edit@* (service_vm_failed_units_exempt
# in host_vars), so they alert only through their own OnFailure hook.
[Unit]
Description=homelab-iac in-chat image generation check for %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=%i
# systemd creates this owned by User=, exports $RUNTIME_DIRECTORY to ExecStart
# and ExecStopPost, and removes it after ExecStopPost. The check drops a
# `submitted` marker here just before POSTing, so the release hook can tell our
# own still-running prompt from someone else's job even when the check's own
# client timeout ended the run as exit 2 / SERVICE_RESULT=success.
RuntimeDirectory=homelab-image-gen-%i
WorkingDirectory=/opt/homelab-iac
# ExecStartPre, NOT ConditionPathIsDirectory: systemd treats an unmet condition
# as SUCCESS, so a missing venv would end nightly checking with every indicator
# green. Same correction as homelab-verify@.service and homelab-scan@.service.
ExecStartPre=/usr/bin/test -d /opt/homelab-iac/.venv
ExecStart=/opt/homelab-iac/.venv/bin/python \
    /opt/homelab-iac/scripts/image_generation_check.py \
    --token-file /etc/homelab-owui-admin.token \
    --metrics-dir /opt/homelab/appdata/node-exporter-textfile
# Release TERRA's card whatever the outcome — success, failure, crash or a
# TimeoutStartSec kill. "-" so a nonzero exit from the hook never changes the
# verdict. systemd passes $SERVICE_RESULT to it; "timeout", or a `submitted` marker, earns a queue drain.
ExecStopPost=-/opt/homelab-iac/.venv/bin/python /opt/homelab-iac/scripts/gpu_host_release.py --check gen
# The release script enforces its own --deadline (390 s by default) so its work
# finishes inside this. If it were killed at the limit anyway, the "-" prefix
# would NOT hide it: a stop-post timeout sets Result=timeout and fails the
# unit, so OnFailure fires. "-" ignores only the hook's exit code.
TimeoutStopSec=420
# Generation against a card that may hold a 17 GB resident chat model, on a
# desktop that may be asleep. Long enough to be a real answer, short enough
# that a hang is reported the same night.
TimeoutStartSec=900
UMask=0077
# Exit 2 is `inconclusive`: the GPU host was unreachable or asleep, which is
# routine on a desktop that is off most nights, not a fault of this estate.
# SuccessExitStatus=2 keeps systemd from marking the unit failed for that
# case, so it does not page. Exit 1 (`broken` — reachable but no image, or
# the wrong size) is a real defect and is deliberately left out of this list,
# so it still fails the unit and still pages.
SuccessExitStatus=2
