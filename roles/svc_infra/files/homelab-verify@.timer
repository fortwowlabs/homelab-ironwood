# Enabled for the runner account by roles/svc_infra/tasks/verify-runner.yml:
#   systemctl enable --now homelab-verify@svcops.timer
[Unit]
Description=Run homelab-iac non-disruptive verification nightly for %i

[Timer]
Unit=homelab-verify@%i.service
# After the backup window (03:09-03:40) and before the backup-freshness
# check at 04:40, so a night's results are complete by breakfast.
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
