{#- Browser view of the same data as scan-report.txt.j2. Deliberately one
    self-contained file with no external CSS, JS, font or image: this page is
    served by a static file server with no network access of its own, and it
    is read exactly when something is wrong, which is the worst time to depend
    on a CDN. -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>homelab security scan</title>
<style>
  :root { color-scheme: light dark; }
  body { font: 15px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
         margin: 0 auto; max-width: 62rem; padding: 2rem 1.25rem 4rem; }
  h1 { font-size: 1.35rem; margin: 0 0 .25rem; }
  .sub { opacity: .7; margin: 0 0 1.75rem; font-size: .9rem; }
  .cards { display: flex; flex-wrap: wrap; gap: .75rem; margin-bottom: 1.75rem; }
  .card { border: 1px solid currentColor; border-radius: .5rem; padding: .7rem 1rem;
          min-width: 8rem; opacity: .95; }
  .card .n { font-size: 1.8rem; font-weight: 700; display: block; line-height: 1.1; }
  .card .l { font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; opacity: .75; }
  .crit .n { color: #c0392b; }
  .imp .n  { color: #b9770e; }
  table { border-collapse: collapse; width: 100%; margin: .5rem 0 2rem; }
  th, td { text-align: right; padding: .4rem .6rem; border-bottom: 1px solid rgba(128,128,128,.35); }
  th:first-child, td:first-child { text-align: left; }
  th { font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; opacity: .75; }
  .bad { color: #c0392b; font-weight: 700; }
  .note { border-left: 3px solid rgba(128,128,128,.5); padding: .1rem 0 .1rem 1rem;
          margin: 1.5rem 0; opacity: .85; font-size: .9rem; }
  .banner { border: 1px solid #c0392b; border-radius: .5rem; padding: .75rem 1rem;
            margin-bottom: 1.5rem; }
  a { color: inherit; }
</style>
</head>
<body>

<h1>homelab security scan</h1>
<p class="sub">{{ ansible_date_time.iso8601 }} &middot; report-only &mdash; this run installed, upgraded and restarted nothing</p>

{% if scan_broken | length > 0 %}
<div class="banner">
  <strong>{{ scan_broken | join(', ') }} could not be scanned.</strong><br>
  A host that could not be asked is not a host with nothing pending. Treat the
  numbers below as a floor, not a total.
</div>
{% endif %}

{% if scan_not_run | default([]) | length > 0 %}
<div class="banner">
  <strong>{{ scan_not_run | length }} check(s) were due tonight and did not run:
  {{ scan_not_run | map(attribute='label') | join('; ') }}.</strong><br>
  A check that did not run reports nothing found. Whatever those checks cover is
  unmeasured on this page, not clean.
</div>
{% endif %}

<div class="cards">
  <div class="card"><span class="n">{{ scan_total }}</span><span class="l">pending errata</span></div>
  <div class="card crit"><span class="n">{{ scan_critical }}</span><span class="l">critical</span></div>
  <div class="card imp"><span class="n">{{ scan_important }}</span><span class="l">important</span></div>
  <div class="card"><span class="n">{{ scan_ok | length }}/{{ groups['service_vms'] | length }}</span><span class="l">hosts answered</span></div>
</div>

<table>
  <thead>
    <tr><th>host</th><th>total</th><th>critical</th><th>important</th><th>moderate</th><th>low</th></tr>
  </thead>
  <tbody>
{% for host in groups['service_vms'] | sort %}
{%   set f = scan_findings[host] | default({}) %}
{%   if f.ok | default(false) | bool %}
    <tr>
      <td>{{ host }}</td>
      <td>{{ f.total }}</td>
      <td{{ ' class="bad"' if (f.critical | int) > 0 else '' }}>{{ f.critical }}</td>
      <td>{{ f.important }}</td>
      <td>{{ f.moderate }}</td>
      <td>{{ f.low }}</td>
    </tr>
{%   else %}
    <tr><td>{{ host }}</td><td colspan="5" class="bad">NOT SCANNED &mdash; {{ f.detail | default('no result recorded') }}</td></tr>
{%   endif %}
{% endfor %}
  </tbody>
</table>

<p>
  Previous run total: <strong>{{ scan_previous.total | default('none — first run') }}</strong> &middot;
  Escalated to alerts: <strong>{{ 'YES — ' ~ scan_escalation_reason if scan_escalate | bool else 'no' }}</strong>
</p>

<h2 style="font-size:1.05rem;margin:2rem 0 .5rem;">Container image vulnerabilities</h2>
{% if infra_image_scan.ok | default(false) | bool %}
<div class="cards">
  <div class="card crit"><span class="n">{{ infra_image_scan.critical }}</span><span class="l">critical</span></div>
  <div class="card imp"><span class="n">{{ infra_image_scan.high }}</span><span class="l">high</span></div>
  <div class="card"><span class="n">{{ infra_image_scan.scanned }}</span><span class="l">images scanned</span></div>
{% if infra_image_scan.failed %}
  <div class="card crit"><span class="n">{{ infra_image_scan.failed }}</span><span class="l">scan failed</span></div>
{% endif %}
</div>

{% if infra_image_scan.eosl | length > 0 %}
<div class="banner">
  <strong>{{ infra_image_scan.eosl | length }} image(s) run a base OS past end-of-life.</strong><br>
  These will never receive another security update, so their counts can only
  grow. This matters more than any single advisory below.
  <ul>{% for ref in infra_image_scan.eosl %}<li>{{ ref.split('@')[0] }}</li>{% endfor %}</ul>
</div>
{% endif %}

<table>
  <thead><tr><th>image</th><th>critical</th><th>high</th><th>built</th><th>base OS</th></tr></thead>
  <tbody>
{% for img in (infra_image_scan.images | selectattr('ok') | sort(attribute='critical', reverse=true))[:20] %}
    <tr>
      <td>{{ img.ref.split('@')[0] }}</td>
      <td{{ ' class="bad"' if (img.critical | int) > 0 else '' }}>{{ img.critical }}</td>
      <td>{{ img.high }}</td>
      <td>{{ img.created[:10] if img.created else '?' }}</td>
      <td>{{ img.os or '?' }}{{ ' (EOL)' if img.eosl else '' }}</td>
    </tr>
{% endfor %}
  </tbody>
</table>
<p style="opacity:.75;font-size:.85rem;">Top 20 by critical count. Full list of what was scanned: <a href="images.txt">images.txt</a></p>
{% else %}
<div class="banner">
  <strong>Images were not scanned.</strong> {{ infra_image_scan.detail | default('no result recorded') }}<br>
  Zero images scanned is not zero vulnerabilities found.
</div>
{% endif %}

{% if scan_default_creds | default([]) | length > 0 %}
<div class="banner">
  <strong>{{ scan_default_creds | join(', ') }} still accept their shipped default credentials.</strong><br>
  Fix these first. Unlike a CVE count this is not a trade-off anyone chose &mdash;
  it is a login anybody on the LAN can look up in the project's own
  documentation, and it takes a minute to change.
</div>
{% endif %}

{% if scan_inconclusive_creds | default([]) | length > 0 %}
<div class="banner">
  <strong>The credential canary reached no verdict on
  {{ scan_inconclusive_creds | join(', ') }}.</strong><br>
  The probe never got as far as telling an accepted login from a refused one, so
  nothing here says whether those services still take their shipped default.
  That is a broken probe, not a passing one.
</div>
{% endif %}

<h2 style="font-size:1.05rem;margin:2rem 0 .5rem;">Default credentials</h2>
{# Keyed off the hosts whose canary reported rather than off the length of the
   findings list: [] is what "no service accepts a default" and "the canary
   died" both look like, and only one of those is good news. #}
{% if scan_credentials_ran_on | default([]) | length > 0 %}
<table>
  <thead><tr><th>service</th><th>verdict</th><th>detail</th></tr></thead>
  <tbody>
{% for c in scan_credentials | sort(attribute='service') %}
    <tr>
      <td>{{ c.service }}</td>
{%   if c.vulnerable %}
      <td class="bad">STILL ACCEPTS ITS SHIPPED DEFAULT</td>
{%   elif c.inconclusive | default(false) %}
      <td class="bad">INCONCLUSIVE &mdash; no verdict reached</td>
{%   else %}
      <td>ok</td>
{%   endif %}
      <td>{{ c.detail }}</td>
    </tr>
{% endfor %}
  </tbody>
</table>
<p style="opacity:.75;font-size:.85rem;">Probed from {{ scan_credentials_ran_on | join(', ') }}. Each attempt uses the credentials in the project's own documentation &mdash; nothing here reads the vault.</p>
{% else %}
<div class="banner">
  <strong>The credential canary did not run.</strong><br>
  No host reported a result. An empty section here is the same finding as a
  service failing the check, not the absence of one.
</div>
{% endif %}

<h2 style="font-size:1.05rem;margin:2rem 0 .5rem;">Exposed ports</h2>
{# Same again: no scanner reporting and no port being open produce the same
   empty list. #}
{% if scan_exposure_ran_on | default([]) | length > 0 %}
<table>
  <thead><tr><th>target</th><th>open</th><th>unexplained</th><th>expected but shut</th></tr></thead>
  <tbody>
{% for e in scan_exposure | sort(attribute='target') %}
    <tr>
      <td>{{ e.target }}</td>
      <td>{{ e.observed | length }}</td>
      <td{{ ' class="bad"' if e.unexpected | length > 0 else '' }}>{{ e.unexpected | join(', ') or '&mdash;' }}</td>
      <td>{{ e.missing | join(', ') or '&mdash;' }}</td>
    </tr>
{% endfor %}
  </tbody>
</table>
<p style="opacity:.75;font-size:.85rem;">Scanned from {{ scan_exposure_ran_on | join(', ') }} &mdash; a host scanning itself goes over loopback and bypasses its own firewall entirely.</p>
{% else %}
<div class="banner">
  <strong>The exposure scan did not run.</strong><br>
  No scanner reported a result. Zero ports found is not zero ports open &mdash; a
  sweep that died on its own port-22 control produces exactly this section.
</div>
{% endif %}

<h2 style="font-size:1.05rem;margin:2rem 0 .5rem;">Benchmark (OpenSCAP)</h2>
{# Three states, not two: "no results" used to render as "not benchmark day"
   whatever the cause, so a Sunday on which every evaluation broke read as a
   Tuesday. #}
{% set oscap_missing = scan_not_run | default([]) | selectattr('check', 'equalto', 'benchmark') | list %}
{% if scan_oscap_ran_on | default([]) | length > 0 %}
<table>
  <thead><tr><th>host</th><th>profile</th><th>pass</th><th>fail</th><th>n/a</th><th>score</th></tr></thead>
  <tbody>
{% for host, profiles in scan_oscap | dictsort %}
{%   for profile, counts in profiles | dictsort %}
{%     set scored = (counts.pass | default(0) | int) + (counts.fail | default(0) | int) %}
    <tr>
      <td>{{ host }}</td>
      <td>{{ profile }}</td>
      <td>{{ counts.pass | default(0) }}</td>
      <td class="bad">{{ counts.fail | default(0) }}</td>
      <td>{{ counts.notapplicable | default(0) }}</td>
      <td>{{ "%.1f%%" | format((100 * (counts.pass | default(0) | int) / scored) if scored else 0) }}</td>
    </tr>
{%   endfor %}
{% endfor %}
  </tbody>
</table>
<div class="note">
  Neither score is a target. STIG is a DoD baseline and most of the gap is
  requirements this estate will never adopt &mdash; FIPS mode, smart-card auth,
  classified audit rules. What matters is the trend: a score that drops means
  something changed on the host. Full HTML report per host lives at
  <code>/var/lib/homelab-scan/oscap-&lt;profile&gt;.html</code>.
</div>
{% if oscap_missing | length > 0 %}
<div class="banner">
  <strong>The benchmark did not run on
  {{ oscap_missing | map(attribute='host') | join(', ') }}.</strong><br>
  The table above covers part of the estate, and it was not recorded as this
  week's baseline.
</div>
{% endif %}
{% elif oscap_missing | length > 0 %}
<div class="banner">
  <strong>The benchmark was due today and produced no result on
  {{ oscap_missing | map(attribute='host') | join(', ') }}.</strong><br>
  That is a broken evaluation rather than a host with nothing to report. The
  previous week's numbers stand and no baseline was written.
</div>
{% else %}
<div class="note">
  Not run today. The benchmark is weekly (Sunday) because it costs ~10 minutes
  of wall clock and ~30 of CPU across every VM to measure a property that only
  moves when host configuration moves. Force it with
  <code>make scan ARGS="-e scan_oscap_force=true"</code>.
</div>
{% endif %}

<p><a href="latest.txt">latest.txt</a> &middot; <a href="state.json">state.json</a> &middot; <a href="images.txt">images.txt</a></p>

<div class="note">
  <p><strong>What this means.</strong> Nothing in this estate updates itself. That is
  a deliberate trade recorded in <code>docs/unattended.md</code>: packages install on
  demand and images are digest-pinned, so nothing shifts underneath while nobody is
  watching. The cost of that trade is the number at the top of this page, and the
  reason this scan exists is that the number was previously unknown rather than
  accepted.</p>
  <p>Acting on it is a manual decision this job will never take for you. Applying
  errata is dnf's security-only upgrade path, run on the host by hand, followed by
  the reboot a kernel or glibc advisory usually requires.</p>
</div>

<div class="note">
  <p><strong>This page is not a secret, and it should be.</strong> The Authelia login in
  front of <code>scan.{{ service_domain }}</code> protects the hostname, not the
  service: this same content is served unauthenticated on
  <code>{{ hostvars[infra_host].ansible_host }}:8085</code> to anything on the LAN
  or the tailnet. That is an accepted risk, recorded in
  <code>docs/automation-opportunities.md</code>.</p>
</div>

</body>
</html>
