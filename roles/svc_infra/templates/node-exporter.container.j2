{{ ansible_managed | comment }}
# ~homelab/.config/containers/systemd/node-exporter.container   (rootless)
# Prometheus host-metrics exporter. Network=host to report the real host
# NICs, and read-only /proc,/sys,rootfs so the node/filesystem collectors
# describe the HOST, not the container (same reasoning as beszel-agent's
# Network=host). No writable state — nothing to persist. Scraped by
# Prometheus on {{ infra_host }} ONLY: firewalld opens :9100 to that single
# source address, not the whole LAN (see files.yml).
# fs-types-exclude keeps the filesystem collector off NFS. Without it the
# collector stats /srv/media each scrape and blocks in D-state when the NAS
# is gone, taking every other metric for this host down with it. The regex
# is node_exporter's own default plus nfs/nfs4; see the var's comment in
# group_vars/all/main.yml and docs/plans/nfs-outage-resilience.md.
[Unit]
Description=Prometheus node exporter

[Container]
Image={{ node_exporter_image }}
ContainerName=node-exporter
Network=host
# Container UID 0 maps to the unprivileged homelab account in this rootless
# unit. Label separation must be disabled so it can read host proc metadata.
User=0
SecurityLabelDisable=true
Volume=/proc:/host/proc:ro
Volume=/sys:/host/sys:ro
Volume=/:/rootfs:ro
# Plain :ro, not :Z. This unit already sets SecurityLabelDisable=true above so
# the node and filesystem collectors can read host /proc metadata, so label
# separation is off for this container and the textfile mount follows the same
# convention /proc, /sys and /rootfs use. On a host whose exporter did NOT
# disable labelling this would need :Z, and an Ansible-written .prom would
# arrive with a default context the container could not read — a silently empty
# chart rather than an error.
Volume={{ infra_textfile_dir }}:/var/lib/node_exporter/textfile:ro
Exec=--path.procfs=/host/proc --path.sysfs=/host/sys --path.rootfs=/rootfs --collector.filesystem.mount-points-exclude=^/(dev|proc|sys|run)($|/) --collector.filesystem.fs-types-exclude={{ node_exporter_fs_types_exclude }} --collector.textfile.directory=/var/lib/node_exporter/textfile

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
