{{ ansible_managed | comment }}
# ~homelab/.config/containers/systemd/nextcloud.container   (rootless)
# Published on svc-infra's LAN IP (not loopback) — Caddy runs on
# {{ media_host }}, a different host (nextcloud.{{ service_domain }}). The
# official image sets no USER at all (the Apache master starts as root and
# drops its worker processes to www-data internally), so container-root maps
# straight to the host homelab user under rootless podman — no User=0
# override or PUID/PGID knob needed here (the Paperless/Home-Assistant
# pattern, not the NetBox/Semaphore one).
[Unit]
Description=Nextcloud
Requires=nextcloud-db.service nextcloud-redis.service
After=nextcloud-db.service nextcloud-redis.service

[Container]
Image={{ nextcloud_images.webserver }}
ContainerName=nextcloud
Network=nextcloud.network
PublishPort={{ ansible_host }}:8081:80
# App code/config/apps/themes — small, local disk, tarred nightly
# (infra_extra_backup_paths carries "nextcloud").
Volume=%h/appdata/nextcloud:/var/www/html:Z
# User files. LOCAL disk, in a directory deliberately OUTSIDE the tarred
# `nextcloud` appdata path above, so the nightly tar keeps covering the small
# app/config tree without ever growing to include arbitrary user uploads.
#
# Why not the NFS media export (which is where Immich's photo library lives,
# and where this originally pointed)? Nextcloud's entrypoint runs as root and
# rsyncs its app tree with `--chown www-data:root`, and the app itself then
# runs as www-data (uid 33). Under rootless podman uid 33 maps to a subuid,
# never to the host homelab user that owns the NFS dir, and the export is
# root-squashed — so the chown fails outright ("chown /var/www/html/data:
# Operation not permitted", container exit 23) and even past it the workers
# could not write. `--userns=keep-id:uid=33` would fix the mapping in theory
# but errors on this host (podman 5.8.2 / crun 1.27). Immich avoids all of
# this only because it never chowns its library.
#
# TRADEOFF, know this: user files therefore live on svc-infra's 120G disk and
# are NOT covered by the NAS-layer backup that protects /srv/media. To put
# bulk data back on the NAS, add the share through Nextcloud's own External
# Storage app — that works at the app layer and sidesteps the uid/NFS problem
# entirely. Watch disk headroom (see the 2026-07-20 rpool-full incident).
Volume=%h/appdata/nextcloud-data:/var/www/html/data:Z
Environment=TZ={{ timezone }}
Environment=POSTGRES_HOST=nextcloud-db
Environment=POSTGRES_DB=nextcloud
Environment=POSTGRES_USER=nextcloud
Environment=POSTGRES_PASSWORD={{ vault_nextcloud_db_password }}
Environment=REDIS_HOST=nextcloud-redis
# Reverse-proxy correctness (the classic Nextcloud footgun): TRUSTED_PROXIES
# must be Caddy's own address — svc-media, a different host from this
# container — never a literal; derived from hostvars so a re-IP stays a
# one-line inventory edit (see inventory/hosts.yml). These are read directly
# by the image's own shipped /usr/src/nextcloud/config/reverse-proxy.config.php
# (getenv() at runtime, every boot) — no manual config.php edit needed.
Environment=TRUSTED_PROXIES={{ hostvars[media_host].ansible_host }}
Environment=OVERWRITEHOST=nextcloud.{{ service_domain }}
Environment=OVERWRITEPROTOCOL=https
Environment=OVERWRITECLIURL=https://nextcloud.{{ service_domain }}
# Space-separated (docker-entrypoint.sh splits on whitespace); only applied
# by the entrypoint on a truly fresh install. Note OVERWRITEHOST being
# non-empty already makes TrustedDomainHelper::isTrustedDomain() return true
# unconditionally (lib/private/Security/TrustedDomainHelper.php) — this list
# is still set for clarity/defense-in-depth, but is not what is actually
# gating access once overwritehost is configured.
Environment="NEXTCLOUD_TRUSTED_DOMAINS=nextcloud.{{ service_domain }} {{ ansible_host }}"
# Non-interactive first-run install (entrypoint only reads these on a truly
# empty /var/www/html) — no manual setup wizard left behind, unlike Home
# Assistant's.
Environment=NEXTCLOUD_ADMIN_USER=admin
Environment=NEXTCLOUD_ADMIN_PASSWORD={{ vault_nextcloud_admin_password }}
# Bump past the image's 512M default for a file-sync tool's browser uploads
# (the desktop/mobile clients and modern Files-app uploads chunk large
# transfers and are unaffected either way — this only helps single-shot
# WebDAV PUTs / older clients).
Environment=PHP_MEMORY_LIMIT=1024M
Environment=PHP_UPLOAD_LIMIT=4G
# The image's Apache config also caps request bodies independently of PHP
# (LimitRequestBody, default 1GiB per the Dockerfile's APACHE_BODY_LIMIT) —
# raising only PHP_UPLOAD_LIMIT above 1G would silently keep failing at the
# Apache layer. 0 = no Apache-side limit; php.ini's PHP_UPLOAD_LIMIT above
# remains the real, still-finite ceiling.
Environment=APACHE_BODY_LIMIT=0
HealthCmd=curl -f http://localhost/status.php || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=120s

[Service]
# No NFS mount guard here (unlike Immich): user files are on local disk, see
# the Volume= comment above.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
