#!/usr/bin/env bash
# backup-infra-appdata.sh — nightly infra-stack backups to the NFS backup
# dataset. RENDERED BY ANSIBLE. Runs as the homelab user (User=homelab in
# backup-infra-appdata.service; rootless podman needs XDG_RUNTIME_DIR, set
# there). `podman unshare` maps container subuids while retaining homelab's
# host identity for NFS writes; this is required for files such as Nextcloud's
# uid-33-owned config.php. Retention: {{ backup_retention_days | default(14) }} days.
#
# What it covers:
#   - Appdata tars: one per backup_path (catalog + bespoke) under
#     /opt/homelab/appdata.
#   - Database dumps: application-consistent `pg_dumpall` of each bespoke
#     Postgres cluster (netbox-db, immich-db) whose subuid-owned data dir
#     cannot be file-tarred — mirrors backup-media.sh's romm-db mariadb-dump.
set -euo pipefail

DEST=/srv/backups/{{ inventory_hostname }}
DB_DEST="$DEST/db"
STAMP=$(date +%F)
NTFY="${NTFY_URL}/${NTFY_TOPIC}"
AUTH=()
if [[ -n "${NTFY_TOKEN:-}" ]]; then
    AUTH=(-H "Authorization: Bearer ${NTFY_TOKEN}")
fi

on_err() {
    logger -p daemon.err -t backup-infra "backup FAILED"
    curl -fsS --max-time 5 -X POST -H "Title: {{ inventory_hostname }} backup FAILED" \
        -H "Priority: high" -H "Tags: floppy_disk" \
        "${AUTH[@]}" \
        -d "backup-infra-appdata.sh failed — check journalctl -u backup-infra-appdata" \
        "$NTFY" >/dev/null 2>&1 || true
}
trap on_err ERR

# Run a tar command, tolerating exit 1 ("some files differ" — a live app
# rewrote a file mid-read, e.g. Grafana's or Semaphore's SQLite); the
# snapshot is still usable, but it is logged as a WARN rather than silently
# accepted. Only exit 2+ is a real failure. Mirrors backup-dl-appdata.sh.
# $1 is a label for the log line; the rest is the command to run.
tar_tolerant() {
    local label="$1"
    shift
    local rc=0
    "$@" || rc=$?
    if (( rc >= 2 )); then
        on_err
        exit "$rc"
    fi
    if (( rc == 1 )); then
        logger -p daemon.warning -t backup-infra \
            "WARN: tar reported changed files while archiving ${label} — snapshot kept, may be inconsistent"
    fi
}

mkdir -p "$DEST" "$DB_DEST"

# 1. Appdata tars. Some rootless containers chown files to an internal UID,
#    which is a host subuid and unreadable to homelab in the initial namespace.
#    podman unshare maps those files back to their container IDs while uid 0
#    remains the host homelab user, so NFS output ownership stays correct.
{% set infra_backup_paths = [] %}
{% for app_name, app in (infra_apps | combine(infra_secret_apps | default({}))).items() %}
{%   for backup_path in app.backup_paths %}
{%     set _ = infra_backup_paths.append(backup_path) %}
{%   endfor %}
{% endfor %}
{% for backup_path in infra_extra_backup_paths %}
{%   set _ = infra_backup_paths.append(backup_path) %}
{% endfor %}
for app in{% for backup_path in infra_backup_paths | unique %} {{ backup_path | quote }}{% endfor %}; do
    tar_tolerant "$app" \
        podman unshare tar -C /opt/homelab/appdata \
        -czf "$DEST/${app}-${STAMP}.tar.gz" "$app"
done

# 2. Database dumps — application-consistent pg_dumpall. POSTGRES_USER is
#    expanded INSIDE the container (single-quoted), reading its own env, so the
#    superuser/db names never need spelling out here. pipefail makes a failed
#    dump abort loudly rather than write a truncated .sql.gz.
{% for db in infra_db_backups %}
podman exec {{ db | quote }} sh -c \
    'exec pg_dumpall -U "$POSTGRES_USER" --clean --if-exists' \
    | gzip > "$DB_DEST/{{ db }}-${STAMP}.sql.gz"
{% endfor %}

# 3. Retention (tars and dumps; find recurses into db/).
find "$DEST" \( -name '*.tar.gz' -o -name '*.sql.gz' \) \
    -mtime +{{ backup_retention_days | default(14) }} -delete
# Completion marker. Reached only if every tar and every dump above succeeded,
# because `set -e` aborts before this line otherwise. backups-fresh.sh reads
# its mtime rather than guessing from artifact ages: the newest .tar.gz being
# recent proves something was written, not that the run finished, so a backup
# that died partway still left a fresh file and reported success.
date -u +%s > "$DEST/.backup-complete"
logger -t backup-infra "backup OK ($STAMP)"
