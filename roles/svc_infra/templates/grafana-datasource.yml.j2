{{ ansible_managed | comment }}
# Grafana datasource provisioning — wires the local Prometheus as the default
# datasource on first boot (no manual UI setup). Grafana and Prometheus are
# both rootless-podman containers on svc-infra; Grafana can't reach the host's
# own LAN IP (firewalld rejects the container's internal source, which isn't
# in lan_cidr), so it uses podman's host.containers.internal gateway to reach
# Prometheus's published 9091 — the same reason prometheus.yml.j2 scrapes the
# local node_exporter via that gateway. No credentials: Prometheus has no auth
# (LAN + firewalld only), same trust model as every other backend here.
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://host.containers.internal:9091
    isDefault: true
    editable: false
