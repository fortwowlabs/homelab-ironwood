#!/usr/bin/env bash
{{ ansible_managed | comment }}
# homelab-verify-run.sh — run the nightly non-disruptive verification and
# report the outcome in both directions.
#
# Two reporting paths, deliberately:
#   - verify.yml's own rescue pushes to ntfy. That is the useful, detailed
#     alert, and it is the one that names the failing host and gate.
#   - this wrapper pings healthchecks.io. That is the one that still works
#     when ntfy, svc-media, the LAN or the power is the thing that broke.
#
# The PVE play is excluded by --limit. The runner has no SSH key for
# root@thurgadin and should not have one: a nightly job holding root on the
# hypervisor is a much larger blast radius than the check is worth. PVE
# reports its own health directly to healthchecks.io instead.
set -uo pipefail

ROOT={{ verify_runner_root | quote }}
SECRET_FILE={{ verify_runner_secret_file | quote }}
RUNNER={{ verify_runner_user | quote }}

# shellcheck source=/dev/null
[[ -r /etc/homelab-healthchecks.env ]] && . /etc/homelab-healthchecks.env

if [[ ! -r "$SECRET_FILE" ]]; then
    echo "$SECRET_FILE is missing — the one-time manual step in docs/operations.md has not been done, so nightly verification cannot run" >&2
    /usr/local/sbin/hc-ping.sh "${HC_PING_VERIFY:-}" fail
    exit 1
fi

# Ansible writes control sockets, temp files and a fact cache; point all of
# them inside the runner's own tree so nothing depends on a writable HOME or
# a shared /tmp.
export ANSIBLE_CONFIG="${ROOT}/ansible.cfg"
export ANSIBLE_HOME="${ROOT}/.ansible"
export ANSIBLE_LOCAL_TEMP="${ROOT}/.ansible/tmp"
export XDG_CACHE_HOME="${ROOT}/.ansible/cache"
mkdir -p "$ANSIBLE_LOCAL_TEMP" "$XDG_CACHE_HOME"

rev=$(cat "${ROOT}/.deployed-rev" 2>/dev/null || echo unknown)
echo "verifying against revision ${rev}"

cd "$ROOT" || exit 1
"${ROOT}/.venv/bin/ansible-playbook" verify.yml \
    --vault-password-file "$SECRET_FILE" \
    --limit 'service_vms:localhost' \
    --extra-vars notify_on_success=false
rc=$?

if (( rc == 0 )); then
    /usr/local/sbin/hc-ping.sh "${HC_PING_VERIFY:-}"
    echo "verification passed (revision ${rev}, runner ${RUNNER})"
    exit 0
fi

/usr/local/sbin/hc-ping.sh "${HC_PING_VERIFY:-}" fail
echo "verification FAILED with rc=${rc} (revision ${rev})" >&2
exit 1
