{{ ansible_managed | comment }}
# Sourced by /usr/local/sbin/chat-egress-apply. One definition of the cgroup
# path, shared by the nft policy, the apply script and the confirm assertion in
# chat-egress.yml — three copies of this string is exactly the drift that
# tests/validate_chat_egress.py exists to prevent.
CHAT_EGRESS_POLICY=/etc/nftables/chat-egress.nft
CHAT_EGRESS_CGROUP={{ chat_egress_cgroup_path }}
CHAT_EGRESS_WAIT_SECONDS={{ chat_egress_wait_seconds }}
