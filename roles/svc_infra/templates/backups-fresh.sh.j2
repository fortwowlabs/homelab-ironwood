#!/usr/bin/env bash
{{ ansible_managed | comment }}
# backups-fresh.sh — one place that answers "are all three VMs still backing
# up?", and the thing that pings the healthchecks.io backups check.
#
# Why this lives on svc-infra rather than in each backup script:
#   - svc-download CANNOT reach hc-ping.com. Its nftables backstop allows
#     egress only to Mullvad, the NAS, LAN ntfy and Beszel; there is no DNS
#     and no outbound 443. Checking its artifacts over the shared NFS export
#     from here covers it without punching a hole in that backstop.
#   - A backup script only runs when its timer fires. A timer that stopped
#     firing at all — masked unit, disabled timer, VM that never came back
#     from a reboot — produces no failure to report. Reading the artifacts
#     detects absence, which is the failure mode that matters here.
#
# Exits nonzero when anything is stale, so the OnFailure drop-in raises the
# ntfy alert. This script owns the healthchecks side; it does not duplicate
# the ntfy side.
set -uo pipefail

BACKUP_ROOT=/srv/backups
MAX_AGE_HOURS={{ backup_max_age_hours | default(26) }}
MIN_ARTIFACT_BYTES={{ backup_min_artifact_bytes | default(1024) }}
HOSTS=({% for h in groups['service_vms'] | sort %}{{ h | quote }} {% endfor %})

# shellcheck source=/dev/null
[[ -r /etc/homelab-healthchecks.env ]] && . /etc/homelab-healthchecks.env

fail() {
    echo "$1" >&2
    /usr/local/sbin/hc-ping.sh "${HC_PING_BACKUPS:-}" fail
    exit 1
}

# /srv/backups is an x-systemd.automount, so a cold path can look empty until
# something touches it. Trigger the mount before concluding anything, and
# treat an unreachable NAS as its own distinct failure — "the NAS is down" and
# "backups stopped running" need different responses.
stat "${BACKUP_ROOT}/." >/dev/null 2>&1 || true
if ! findmnt -n -t nfs4 -M "$BACKUP_ROOT" >/dev/null 2>&1; then
    fail "backup share ${BACKUP_ROOT} is not mounted — the NAS is unreachable, so backup freshness is UNKNOWN, not OK"
fi

stale=""
for host in "${HOSTS[@]}"; do
    dir="${BACKUP_ROOT}/${host}"
    if [[ ! -d "$dir" ]]; then
        stale+=$'\n'"${host}: no backup directory at ${dir}"
        continue
    fi
    # Recency comes from the completion marker, not from artifact mtimes. Each
    # backup script writes it as its last action under `set -e`, so it is
    # reachable only when every archive and dump in that run succeeded. The
    # newest .gz being recent proves only that something was written: a run
    # that tarred four of twenty apps and then hit ENOSPC still leaves a fresh
    # file, and this check used to call that OK every night indefinitely.
    marker="${dir}/.backup-complete"
    if [[ ! -f "$marker" ]]; then
        stale+=$'\n'"${host}: no completion marker at ${marker} — no backup run has finished successfully"
        continue
    fi
    marker_epoch=$(stat -c %Y "$marker" 2>/dev/null || echo 0)
    marker_age_h=$(( ( $(date +%s) - marker_epoch ) / 3600 ))
    if (( marker_age_h > MAX_AGE_HOURS )); then
        stale+=$'\n'"${host}: last completed backup was ${marker_age_h}h ago (limit ${MAX_AGE_HOURS}h)"
        continue
    fi

    # The marker says the run finished; this says it produced something worth
    # keeping. -size +0c excludes zero-byte files, and the byte floor catches
    # the case a size test alone misses: a failed `pg_dumpall | gzip` still
    # writes a structurally valid ~20-byte gzip that `gzip -t` accepts.
    #
    # Deliberately no `gzip -t`/`tar -tzf` here. Archive integrity is already
    # gated per host in each role's verify.yml, and decompressing multi-gigabyte
    # media archives over NFS every night would risk exceeding this unit's
    # start timeout — turning a working check into a nightly false alarm.
    newest=$(find "$dir" -type f -name '*.gz' -size +0c -printf '%s %p\n' 2>/dev/null \
                 | sort -rn | head -1)
    if [[ -z "$newest" ]]; then
        stale+=$'\n'"${host}: no non-empty backup artifacts under ${dir}"
        continue
    fi
    bytes=${newest%% *}
    path=${newest#* }
    if (( bytes < MIN_ARTIFACT_BYTES )); then
        stale+=$'\n'"${host}: largest artifact is only ${bytes} bytes (floor ${MIN_ARTIFACT_BYTES}): ${path}"
        continue
    fi
    echo "${host}: OK, last completed ${marker_age_h}h ago, largest artifact ${bytes} bytes"
done

if [[ -n "$stale" ]]; then
    fail "stale or missing backups:${stale}"
fi

/usr/local/sbin/hc-ping.sh "${HC_PING_BACKUPS:-}"
echo "all backups fresh (limit ${MAX_AGE_HOURS}h)"
exit 0
