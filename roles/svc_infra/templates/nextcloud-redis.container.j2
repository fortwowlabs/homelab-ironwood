{{ ansible_managed | comment }}
[Unit]
Description=Nextcloud Redis (valkey)

[Container]
Image={{ nextcloud_images.redis }}
ContainerName=nextcloud-redis
Network=nextcloud.network
# valkey (redis-wire-compatible), never stock redis — the paperless/netbox
# lesson (commit 06ee437). NO persistent volume, and persistence is turned
# off outright: this is purely Nextcloud's distributed cache + transactional
# file-locking backend, so there is nothing worth keeping across a restart.
# Follows immich-redis (also volume-less), NOT paperless-redis.
#
# This is deliberate, not an oversight. With a bind-mounted /data this
# container wedges: the valkey image's entrypoint drops privileges from
# container-root to its own `valkey` user, which under rootless podman lands
# on a SUBUID (observed: host uid 590822), not the homelab user that owns the
# appdata directory — so the RDB child cannot create its temp file
# ("Failed opening the temp RDB file ... Permission denied"), every save
# fails, and once stop-writes-on-bgsave-error trips, Nextcloud 503s because
# its lock backend rejects writes. netbox-redis only escapes this because its
# appendonlydir happens to already be owned by that subuid. No auth: reachable
# only on the private nextcloud.network.
Environment=TZ={{ timezone }}
# --save "" disables RDB snapshots entirely; --appendonly no disables AOF.
Exec=valkey-server --save "" --appendonly no
HealthCmd=redis-cli ping | grep -q PONG
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=10s
# Gate readiness on a real PING so nextcloud.service (Requires=+After=) waits
# for the cache to answer, not merely for the container to start.
Notify=healthy

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
