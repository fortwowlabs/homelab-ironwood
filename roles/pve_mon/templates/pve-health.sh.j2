#!/usr/bin/env bash
{{ ansible_managed | comment }}
# pve-health.sh — the hypervisor's daily "I am alive and my disks are fine"
# report, and the outbound half of its healthchecks.io check.
#
# Every service VM is a guest on this machine. If it dies, all three VMs die
# with it and nothing on the LAN is left to say so — which is why liveness
# here is reported OUT to healthchecks.io rather than in to ntfy.
#
# Checks, in the order that matters:
#   1. Pool health. zed alerts on the transition; this catches a pool that
#      was already degraded before any of this was installed.
#   2. Pool and filesystem CAPACITY. See the long comment at the capacity
#      block: this is the one hypervisor failure with no other route out.
#   3. Scrub age. A scrub that silently stopped running means undetected bit
#      rot, and nothing else in this repo would ever notice.
#   4. That zed and smartd are still wired to the ntfy hooks, because the
#      nightly runner cannot check this host at all.
#   5. Failed units, since PVE has no failed-unit watcher of its own.
#
# Exits nonzero on a problem so the OnFailure drop-in raises the ntfy alert;
# it owns the healthchecks side only.
set -uo pipefail

SCRUB_MAX_DAYS={{ pve_scrub_max_age_days | default(45) }}
# Overridable the same way diskguard's THRESH is, so the capacity branch can be
# exercised on a healthy host instead of being trusted on first use.
CRIT_THRESH="${CRIT_THRESH:-{{ pve_disk_critical_threshold | default(90) }}}"

# shellcheck source=/dev/null
[[ -r /etc/homelab-healthchecks.env ]] && . /etc/homelab-healthchecks.env

problems=""

status=$(zpool status -x 2>&1)
if [[ "$status" != "all pools are healthy" ]]; then
    problems+=$'\n'"zpool status -x: ${status}"
fi

# Capacity. This block is the reason the check exists in its current form.
#
# A 100%-full pool is still ONLINE and `zpool status -x` still says "all pools
# are healthy" — capacity is not a ZFS health state — so every check above this
# passed happily through the 2026-07-20 rpool outage. The early warning at
# {{ pve_disk_threshold | default(80) }}% is pve-diskguard's job, but it can only
# push to ntfy, which runs on svc-media, whose own zvol lives on the pool that
# is filling. As the pool approaches full the thin-provisioned guests freeze and
# ntfy freezes with them, so every alert after that point has nowhere to go.
#
# Reporting capacity here puts it on the healthchecks.io path instead, which
# leaves the house. The threshold is deliberately higher than diskguard's: ntfy
# handles "keep an eye on this", and this handles "the estate is about to stop",
# so a pool sitting at 82% for a week does not hold the external check red and
# train the operator to ignore it.
if zpool_cap=$(zpool list -H -o name,capacity 2>/dev/null); then
    while read -r pool_name cap; do
        [[ -n "$pool_name" ]] || continue
        c=${cap%\%}
        [[ "$c" =~ ^[0-9]+$ ]] || continue
        if (( c >= CRIT_THRESH )); then
            problems+=$'\n'"pool ${pool_name} is ${c}% full (critical ${CRIT_THRESH}%) — thin zvols on a full pool freeze every guest"
        fi
    done <<< "$zpool_cap"
else
    problems+=$'\n'"zpool list failed; pool capacity is UNKNOWN, which is not the same as fine"
fi

if df_cap=$(df -P / /var/lib/vz 2>/dev/null); then
    while read -r pct mount; do
        p=${pct%\%}
        [[ "$p" =~ ^[0-9]+$ ]] || continue
        if (( p >= CRIT_THRESH )); then
            problems+=$'\n'"${mount} is ${p}% full (critical ${CRIT_THRESH}%)"
        fi
    done < <(printf '%s\n' "$df_cap" | tail -n +2 | awk '{print $5, $6}')
else
    problems+=$'\n'"df failed; filesystem capacity is UNKNOWN, which is not the same as fine"
fi

# `zpool status` prints scrub state per pool. "scrub repaired ... on <date>"
# for a completed one, "scrub in progress" while running.
now=$(date +%s)
while read -r pool; do
    [[ -n "$pool" ]] || continue
    line=$(zpool status "$pool" 2>/dev/null | grep -E '^\s*scan:' || true)
    if [[ "$line" == *"in progress"* ]]; then
        continue
    fi
    if [[ "$line" != *"scrub repaired"* ]]; then
        problems+=$'\n'"${pool}: no completed scrub on record (${line:-no scan line})"
        continue
    fi
    # Trailing date, e.g. "... on Sun Jul 12 00:24:11 2026"
    when=${line#*" on "}
    epoch=$(date -d "$when" +%s 2>/dev/null || echo 0)
    if [[ "$epoch" == 0 ]]; then
        problems+=$'\n'"${pool}: could not parse scrub date from: ${line}"
        continue
    fi
    age_d=$(( (now - epoch) / 86400 ))
    if (( age_d > SCRUB_MAX_DAYS )); then
        problems+=$'\n'"${pool}: last scrub was ${age_d} days ago (limit ${SCRUB_MAX_DAYS}); check /etc/cron.d/zfsutils-linux"
    else
        echo "${pool}: scrub ${age_d}d ago, pool healthy"
    fi
done < <(zpool list -H -o name 2>/dev/null)

# Alert-path wiring. roles/pve_mon/tasks/verify.yml asserts the same two things,
# but that play is excluded from the nightly run: verify-run.sh passes
# --limit 'service_vms:localhost' because the runner on svc-infra has no root
# SSH key for this host. Those asserts therefore only fire when the operator
# runs `make verify` from the workstation, which is precisely what does not
# happen while the house is empty. A PVE or zfs-zed package upgrade rewriting
# /etc/zfs/zed.d/zed.rc as a dpkg conffile would revert ZED_EMAIL_PROG and send
# pool degradation back to unread local root mail, with zed still `active` so
# nothing else would notice.
if ! grep -qF 'ZED_EMAIL_PROG="/usr/local/sbin/zed-ntfy.sh"' /etc/zfs/zed.d/zed.rc 2>/dev/null; then
    problems+=$'\n'"zed no longer points at the ntfy hook; ZFS pool events would go to unread local root mail"
fi
if ! grep -qF '/usr/local/sbin/smartd-ntfy.sh' /etc/smartd.conf 2>/dev/null; then
    problems+=$'\n'"smartd no longer points at the ntfy hook; disk warnings would go to unread local root mail"
fi
for unit in zfs-zed smartmontools; do
    if ! systemctl is-active --quiet "$unit" 2>/dev/null; then
        problems+=$'\n'"${unit} is not running; the alerts it delivers are dead"
    fi
done

failed=$(systemctl --failed --plain --no-legend 2>/dev/null | grep -v '^notify-failure@' || true)
if [[ -n "$failed" ]]; then
    problems+=$'\n'"failed units:"$'\n'"${failed}"
fi

if [[ -n "$problems" ]]; then
    echo "PVE health problems:${problems}" >&2
    /usr/local/sbin/hc-ping.sh "${HC_PING_PVE:-}" fail
    exit 1
fi

/usr/local/sbin/hc-ping.sh "${HC_PING_PVE:-}"
echo "PVE healthy"
exit 0
