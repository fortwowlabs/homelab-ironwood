#!/usr/bin/env bash
{{ ansible_managed | comment }}
# credential-canary.sh — try each service's SHIPPED DEFAULT credentials and
# report any that still work. Emits JSON on stdout.
#
# This exists because it already happened here. CLAUDE.md lists "a service still
# accepting its upstream default credentials" as one of two real faults that hid
# behind all-green checks, and docs/first-login-walkthrough.md still records
# Calibre-Web's admin/admin123 as live and a manual first-login fix. Every other
# check in this repo would report that estate as perfectly healthy.
#
# The credentials below are UPSTREAM PUBLISHED DEFAULTS, not secrets: they are
# in each project's own documentation. Nothing here reads the vault, which also
# means it works unchanged on the nightly runner, whose checkout has no vault at
# all. A canary that needed the vault would be a canary that never ran at 05:30.
#
# Adding a service: find its documented default, work out a request that
# distinguishes accepted from rejected, and — this is the part that matters —
# verify the check FAILS against the real password before trusting it to pass.
# A probe that can never succeed is indistinguishable from a secure service.
#
# THREE verdicts, not two, and the third is the whole point. A probe has three
# possible outcomes: the default worked, the default was refused, and the probe
# never got far enough to find out. Collapsing the third into the second is how
# this check breaks silently — a missing CSRF token, a connection refused, or a
# curl timeout all used to emit `false`, which the report rendered as the word
# `ok` and escalation ignored entirely. That mattered less while Calibre-Web
# still accepted admin/admin123, because the canary had one probe that MUST come
# back vulnerable and a broken run showed up as that probe going quiet. Since
# 2026-08-03 the default is changed and all three probes report clean, so there
# is no longer any positive control in the output: a working canary and a
# completely broken one now produce byte-identical JSON unless "could not look"
# is a state of its own. It is, below, and scan.yml escalates on it.
set -uo pipefail

results=()

emit() {
    # $1 service, $2 verdict (vulnerable|ok|inconclusive), $3 detail
    #
    # `vulnerable` stays a plain JSON boolean rather than becoming a tri-state
    # string: scan.yml filters the findings with selectattr('vulnerable') and
    # the reports test it for truth, and a string would make every one of those
    # read true. `inconclusive` is carried alongside it instead.
    local service=$1 verdict=$2 detail=$3
    local vulnerable=false inconclusive=false
    case "$verdict" in
        vulnerable)   vulnerable=true ;;
        ok)           ;;
        inconclusive) inconclusive=true ;;
        # An unrecognised verdict is a bug in this script, and a bug in this
        # script must not report the estate as clean.
        *)            inconclusive=true
                      detail="canary bug: unknown verdict '${verdict}' — ${detail}" ;;
    esac
    results+=("{\"service\":\"${service}\",\"vulnerable\":${vulnerable},\"inconclusive\":${inconclusive},\"detail\":\"${detail}\"}")
}

# curl writes 000 when it never received an HTTP response at all: connection
# refused, TLS failure, or the -m 10 timeout expiring. A 5xx means the service
# answered but with its own failure rather than an authentication decision.
# Neither is evidence that the default was rejected — they are evidence that
# nobody asked.
no_verdict() {
    [[ "$1" == "000" || "$1" == 5[0-9][0-9] ]]
}

{% if 'media_vms' in group_names %}
# --- Calibre-Web -----------------------------------------------------------
# Loopback-only on this host, so it is checked from here rather than over the
# LAN. Login is CSRF-protected: a bare POST returns 400 for a correct and an
# incorrect password alike, so the token and session cookie have to be carried
# or the probe cannot tell the two apart. Measured signature: 302 to / when the
# credentials are accepted, 200 re-rendering the form when they are not.
calibre_default_check() {
    local jar token code
    if ! jar=$(mktemp); then
        # Silently returning here used to drop calibre-web out of the report
        # altogether, and a service that is absent from a list of findings is
        # a service nobody notices is unmeasured.
        emit calibre-web inconclusive "could not create a cookie jar (mktemp failed)"
        return 0
    fi
    token=$(curl -s -m 10 -c "$jar" http://127.0.0.1:8083/login 2>/dev/null \
        | grep -oE 'name="csrf_token"[^>]*value="[^"]+"' \
        | grep -oE 'value="[^"]+"' | cut -d'"' -f2)
    if [[ -z "$token" ]]; then
        rm -f "$jar"
        emit calibre-web inconclusive "could not read the login form; no CSRF token, so no login was ever attempted"
        return 0
    fi
    code=$(curl -s -m 10 -b "$jar" -c "$jar" -o /dev/null -w '%{http_code}' \
        -X POST -d "csrf_token=${token}&username=admin&password=admin123&submit=" \
        http://127.0.0.1:8083/login 2>/dev/null)
    rm -f "$jar"
    # Only the two MEASURED codes are verdicts. Anything else — 000 for a
    # timeout, 400 for a CSRF token this probe failed to carry, 5xx for a sick
    # container — means the signature this check reads was never produced, and
    # the 400 case is precisely the one that returns identically for a right and
    # a wrong password.
    if [[ "$code" == "302" ]]; then
        emit calibre-web vulnerable "admin/admin123 still accepted (HTTP 302)"
    elif [[ "$code" == "200" ]]; then
        emit calibre-web ok "default rejected (HTTP 200, login form re-rendered)"
    else
        emit calibre-web inconclusive "neither login signature seen (HTTP ${code}); 302 accepts and 200 rejects, so this is not a verdict"
    fi
}
calibre_default_check
{% endif %}

{% if 'infra_vms' in group_names %}
# --- Grafana ---------------------------------------------------------------
# Basic auth against the API is the cleanest possible probe: 200 means the
# credentials were accepted, 401 means they were not, with no form, cookie or
# CSRF token in the way. GF_SECURITY_ADMIN_PASSWORD is set from the vault, so
# this is expected to report clean — which is exactly what makes it a useful
# NEGATIVE control for the canary itself.
grafana_code=$(curl -s -m 10 -o /dev/null -w '%{http_code}' \
    -u admin:admin http://{{ ansible_host }}:3005/api/org 2>/dev/null)
if [[ "$grafana_code" == "200" ]]; then
    emit grafana vulnerable "admin/admin still accepted (HTTP 200)"
elif no_verdict "$grafana_code"; then
    emit grafana inconclusive "no authentication decision from :3005 (HTTP ${grafana_code})"
else
    emit grafana ok "default rejected (HTTP ${grafana_code})"
fi

# --- Mealie ----------------------------------------------------------------
# Ships changeme@example.com / MyPassword and creates that account on first
# start unless overridden.
mealie_code=$(curl -s -m 10 -o /dev/null -w '%{http_code}' \
    -X POST -H 'Content-Type: application/x-www-form-urlencoded' \
    -d 'username=changeme@example.com&password=MyPassword' \
    http://{{ ansible_host }}:9925/api/auth/token 2>/dev/null)
if [[ "$mealie_code" == "200" ]]; then
    emit mealie vulnerable "changeme@example.com/MyPassword still accepted (HTTP 200)"
elif no_verdict "$mealie_code"; then
    emit mealie inconclusive "no authentication decision from :9925 (HTTP ${mealie_code})"
else
    emit mealie ok "default rejected (HTTP ${mealie_code})"
fi
{% endif %}

printf '{"checks":['
printf '%s' "$(IFS=,; echo "${results[*]:-}")"
printf ']}'
