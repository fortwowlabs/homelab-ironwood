{{ ansible_managed | comment }}
# ~homelab/.config/containers/systemd/jellyfin.container   (rootless)
# RENDERED BY ANSIBLE from roles/svc_media/templates/jellyfin.container.j2
#
# Ports: 8096 published on the LAN IP ONLY — not 0.0.0.0 — so it isn't
# exposed on unintended interfaces. LAN clients direct-play against
# http://{{ ansible_host }}:8096 (firewalld rich rule scopes it to the LAN
# source range); everything else goes through Caddy at jellyfin.{{ service_domain }}
# (reached over the tailnet via the subnet router).
#
# Transcoding: 3700X host, NO GPU — CPU transcode. A 4K HDR remux re-encoded
# to 1080p SDR measured 1.2x realtime on 6 vCPU (the VM now has 8); prefer
# direct-play clients.
#
# /cache/transcodes (the image's default transcode path) is the dedicated
# scsi1 disk mounted at {{ media_transcode_dir }}, NOT tmpfs. The old 6g tmpfs
# filled in about a minute on a 4K remux, ffmpeg then wrote 0-byte segments
# without logging anything, and playback stopped dead at the last real one —
# while the tmpfs held 6G of a 10G VM's RAM. What keeps the disk from filling
# is Jellyfin's throttling + segment deletion (roles/svc_media/tasks/
# transcodes.yml); the separate disk only bounds the damage if they don't.
[Unit]
Description=Jellyfin
# Retry budget for the NFS guard in ExecStartPre below. A rootless USER unit
# cannot order against srv-media.automount (a system unit the user manager
# cannot see), so the guard plus this budget is the only mechanism that makes
# a cold start survivable.
#
# The defaults were actively dangerous here: `Restart=on-failure` with no
# RestartSec retries every 100ms, and the default StartLimitBurst=5 in 10s
# means five attempts inside half a second and then permanent failure. Against
# a TrueNAS that needs ~90s to serve NFS from cold, that is no retry at all.
# This survived the 2026-08-04 cold start only because the user session starts
# slowly enough that NFS had landed one second earlier. See
# docs/plans/cold-start-resilience.md.
StartLimitIntervalSec=600
StartLimitBurst=30

[Container]
Image={{ media_images.jellyfin }}
ContainerName=jellyfin
PublishPort={{ ansible_host }}:8096:8096
Volume=%h/appdata/jellyfin/config:/config:Z
Volume=%h/appdata/jellyfin/cache:/cache:Z
Volume=/srv/media/tv:/media/tv:ro
Volume=/srv/media/movies:/media/movies:ro
Volume={{ media_transcode_dir }}:/cache/transcodes:Z
Environment=JELLYFIN_PublishedServerUrl=http://{{ ansible_host }}:8096

[Service]
# Refuse to start on a bare mountpoint: stat triggers the automount,
# findmnt proves real nfs4 is behind it. The transcode disk mounts nofail, so
# without its check a missing disk would put segments back on root.
ExecStartPre=/bin/sh -c 'stat /srv/media/. >/dev/null && findmnt -t nfs4 -M /srv/media >/dev/null && mountpoint -q {{ media_transcode_dir }}'
Restart=on-failure
# Without this, Restart defaults to 100ms and the budget above is spent
# instantly. 10s x 30 attempts covers a cold NAS.
RestartSec=10

[Install]
WantedBy=default.target
