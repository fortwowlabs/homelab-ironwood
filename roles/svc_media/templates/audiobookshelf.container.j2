{{ ansible_managed | comment }}
[Unit]
Description=Audiobookshelf
# Retry budget for the NFS guard in ExecStartPre below. A rootless USER unit
# cannot order against srv-media.automount, so the guard plus this budget is
# the only thing that makes a cold start survivable. The defaults (100ms
# RestartSec, 5 attempts in 10s) are spent in under a second — no retry at all
# against a TrueNAS that needs ~90s to serve NFS.
# See docs/plans/cold-start-resilience.md.
StartLimitIntervalSec=600
StartLimitBurst=30

[Container]
Image={{ media_images.audiobookshelf }}
ContainerName=audiobookshelf
PublishPort=127.0.0.1:13378:80
Volume=%h/appdata/audiobookshelf/config:/config:Z
Volume=%h/appdata/audiobookshelf/metadata:/metadata:Z
Volume=/srv/media/audiobooks:/audiobooks
Volume=/srv/media/ebooks:/ebooks:ro
Volume=/srv/backups/audiobookshelf:/config/backups
Environment=TZ={{ timezone }}

[Service]
ExecStartPre=/bin/sh -c 'stat /srv/media/. >/dev/null && findmnt -t nfs4 -M /srv/media >/dev/null && stat /srv/backups/. >/dev/null && findmnt -t nfs4 -M /srv/backups >/dev/null'
Restart=on-failure
# Pairs with StartLimitBurst above; the 100ms default would spend it instantly.
RestartSec=10

[Install]
WantedBy=default.target
