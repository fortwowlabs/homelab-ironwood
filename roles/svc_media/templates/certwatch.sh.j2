#!/usr/bin/env bash
{{ ansible_managed | comment }}
# homelab-certwatch.sh — fail loudly before the wildcard certificate expires.
#
# certbot-renew.timer renews at 30 days remaining and, until now, said nothing
# when it could not: a Cloudflare token rotation or an API change would show
# up as every single service going untrusted, three weeks later, with no
# warning. This is the warning.
#
# Unlike the other alert scripts this one deliberately EXITS NONZERO on a
# problem: the OnFailure drop-in turns that into the alert, so there is one
# alerting path to keep working instead of two. It checks the certificate on
# disk, not the timer's status — a renewal that "succeeded" but wrote nothing
# is exactly the failure mode worth catching.
set -uo pipefail

# THREE copies of the certificate exist, and the one that matters is the one in
# Caddy's memory.
#
# certbot writes to /etc/letsencrypt/live, a deploy hook at
# /etc/letsencrypt/renewal-hooks/deploy/caddy.sh copies it to
# /etc/caddy/certs/fullchain.pem, and Caddy serves whatever it last LOADED from
# there. Each hop fails silently on its own: a missing hook leaves the copy
# stale (certbot exits 0, the live cert looks perfect every day), and a reload
# that does not take leaves Caddy serving the old certificate while both files
# on disk are fine. The second is not hypothetical: on 2026-11-25 `caddy reload`
# answered "config is unchanged" after a renewal and Caddy kept the old cert.
# `make verify`'s cert gate asserts issuer and SAN, which an expired cert still
# has, so none of this would be noticed until browsers refused the site.
#
# So the files are checked for expiry, the served certificate is fetched over
# TLS and compared to the copy on disk, and that copy is compared to the live
# one. "Could not fetch" is a problem of its own, never a pass.
LIVE_CERT={{ ('/etc/letsencrypt/live/' ~ service_domain ~ '/fullchain.pem') | quote }}
CADDY_CERT=/etc/caddy/certs/fullchain.pem
SERVED_HOST={{ ansible_host | quote }}
SERVED_PORT=443
SERVED_SNI={{ ('home.' ~ service_domain) | quote }}
PROBE_TIMEOUT=10
# Caddy restarting under a deploy handler or package upgrade can land in the daily
# run; without one retry that costs a full day of alerts.
PROBE_RETRY_DELAY=5
CERTS=("$LIVE_CERT" "$CADDY_CERT")
DAYS={{ cert_expiry_days | default(21) }}

fp_file() { openssl x509 -noout -fingerprint -sha256 -in "$1" 2>/dev/null | cut -d= -f2; }
probe_served() {
    timeout "$PROBE_TIMEOUT" openssl s_client -connect "${SERVED_HOST}:${SERVED_PORT}" -servername "$SERVED_SNI" </dev/null 2>/dev/null | openssl x509 -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2
}

problems=""
for cert in "${CERTS[@]}"; do
    if [[ ! -r "$cert" ]]; then
        problems+=$'\n'"certificate ${cert} is missing or unreadable"
        continue
    fi

    enddate=$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2-)
    if [[ -n "$enddate" ]]; then
        end_epoch=$(date -d "$enddate" +%s 2>/dev/null || echo 0)
        now=$(date +%s)
        remaining=$(( (end_epoch - now) / 86400 ))
        echo "certificate ${cert} expires ${enddate} (${remaining} days remaining, threshold ${DAYS})"
    fi

    # -checkend is the authoritative test; the message above is just context for
    # whoever reads the journal after the alert.
    if ! openssl x509 -checkend $(( DAYS * 86400 )) -noout -in "$cert" >/dev/null 2>&1; then
        problems+=$'\n'"${cert} expires within ${DAYS} days and has not renewed — check certbot-renew.service, the Cloudflare API token, and the Caddy deploy hook"
    fi
done

served_fp=$(probe_served)
if [[ -z "$served_fp" ]]; then
    sleep "$PROBE_RETRY_DELAY"
    served_fp=$(probe_served)
fi
caddy_fp=$(fp_file "$CADDY_CERT")
live_fp=$(fp_file "$LIVE_CERT")

if [[ -z "$served_fp" ]]; then
    problems+=$'\n'"could not read the certificate Caddy is serving on ${SERVED_HOST}:${SERVED_PORT} (SNI ${SERVED_SNI})"
else
    echo "Caddy is serving ${served_fp}"
    if [[ -n "$caddy_fp" && "$served_fp" != "$caddy_fp" ]]; then
        problems+=$'\n'"Caddy is serving a different certificate than ${CADDY_CERT} — the reload after renewal did not take; run: caddy reload --force --config /etc/caddy/Caddyfile (if it still differs, sudo systemctl restart caddy)"
    fi
fi

if [[ -n "$caddy_fp" && -n "$live_fp" && "$caddy_fp" != "$live_fp" ]]; then
    problems+=$'\n'"${CADDY_CERT} differs from ${LIVE_CERT} — the certbot deploy hook did not copy the renewal"
fi

if [[ -n "$problems" ]]; then
    echo "certificate problems:${problems}" >&2
    exit 1
fi

exit 0
