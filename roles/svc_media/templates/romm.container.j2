{{ ansible_managed | comment }}
[Unit]
Description=RomM
# Retry budget for the NFS guard in ExecStartPre below. A rootless USER unit
# cannot order against srv-media.automount, so the guard plus this budget is
# the only thing that makes a cold start survivable. The defaults (100ms
# RestartSec, 5 attempts in 10s) are spent in under a second — no retry at all
# against a TrueNAS that needs ~90s to serve NFS.
# See docs/plans/cold-start-resilience.md.
StartLimitIntervalSec=600
StartLimitBurst=30
Requires=romm-db.service
After=romm-db.service

[Container]
Image={{ media_images.romm }}
ContainerName=romm
Network=romm.network
EnvironmentFile=%h/appdata/romm/romm.env
PublishPort=127.0.0.1:8081:8080
Volume=/srv/media/romm:/romm/library
Volume=%h/appdata/romm/resources:/romm/resources:Z
Volume=%h/appdata/romm/redis-data:/redis-data:Z
Volume=%h/appdata/romm/assets:/romm/assets:Z
Volume=%h/appdata/romm/config:/romm/config:Z
Environment=TZ={{ timezone }}

[Service]
ExecStartPre=/bin/sh -c 'stat /srv/media/. >/dev/null && findmnt -t nfs4 -M /srv/media >/dev/null'
Restart=on-failure
# Pairs with StartLimitBurst above; the 100ms default would spend it instantly.
RestartSec=10

[Install]
WantedBy=default.target
