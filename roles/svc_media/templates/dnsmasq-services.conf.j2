{{ ansible_managed | comment }}
# {{ service_domain }} resolver — RENDERED from roles/svc_media/templates/
# dnsmasq-services.conf.j2, iterating the media/infra catalog and the same
# proxy-enabled download catalog as Caddy, plus extra_dns_records for
# non-HTTP services that have no Caddy vhost to hang a name off of (see
# below). This box is authoritative for
# {{ service_domain }} only; pfSense
# forwards the domain here (Domain Override) and Tailscale split-DNS points the
# tailnet here too — see docs/services.md.

# Bind only the LAN IP so we never fight systemd-resolved on 127.0.0.53.
# The address can appear after dnsmasq starts during boot; Linux bind-dynamic
# attaches it when NetworkManager finishes instead of failing the unit.
listen-address={{ ansible_host }}
bind-dynamic

# We answer {{ service_domain }} and nothing else; no upstream forwarding.
no-resolv
domain-needed
bogus-priv

# Physical hosts by name.
host-record={{ media_host }}.{{ service_domain }},{{ ansible_host }}
host-record={{ download_host }}.{{ service_domain }},{{ hostvars[download_host].ansible_host }}
host-record=truenas.{{ service_domain }},{{ truenas_ip }}
host-record=thurgadin.{{ service_domain }},{{ hostvars['thurgadin'].pve_api_host }}

# Every service name -> Caddy on {{ media_host }} (which reverse-proxies by hostname).
{% for name in caddy_services | dictsort | map('first') %}
address=/{{ name }}.{{ service_domain }}/{{ ansible_host }}
{% endfor %}
{% for name, app in download_apps | dictsort if app.proxy %}
address=/{{ name }}.{{ service_domain }}/{{ ansible_host }}
{% endfor %}

# Non-HTTP services with no Caddy vhost (raw TCP/UDP protocols — Caddy only
# proxies HTTP(S)) get a plain A record here instead, via extra_dns_records
# (inventory/group_vars/all/minecraft.yml today; any future non-HTTP
# service appends to that same list rather than editing this template).
# `host` is an inventory_hostname, resolved through hostvars — never a
# literal IP — exactly like the physical-host records above.
{% for rec in extra_dns_records | default([]) %}
address=/{{ rec.name }}.{{ service_domain }}/{{ hostvars[rec.host].ansible_host }}
{% endfor %}
