{{ ansible_managed | comment }}
# Caddyfile — svc-media reverse proxy for *.{{ service_domain }}
#
# RENDERED from roles/svc_media/templates/Caddyfile.j2, iterating the
# media/infra `caddy_services` catalog and the proxy-enabled entries in
# `download_apps`. Add services to those catalogs, not here.
#
# Every service is one hostname route on :443, bound to the LAN IP
# ({{ ansible_host }}); dnsmasq answers <name>.{{ service_domain }} -> that IP,
# and the tailnet reaches the same IP via the subnet router (Tailscale
# split-DNS). Certbot obtains and renews the publicly trusted wildcard
# certificate with a Cloudflare DNS-01 challenge.
{
	auto_https disable_redirects
	# No HTTP/3: SELinux labels these ports tcp-only, QUIC would EACCES.
	servers {
		protocols h1 h2
	}
}

https://*.{{ service_domain }} {
	bind {{ ansible_host }}
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

{% for name, svc in caddy_services | dictsort %}
	# --- {{ name }} ---
	@{{ name }} host {{ name }}.{{ service_domain }}
	handle @{{ name }} {
{% if (svc.tls_skip_verify | default(false)) or (svc.host_header is defined) %}
		reverse_proxy {{ svc.scheme | default('http') }}://{{ svc.backend }} {
{% if svc.tls_skip_verify | default(false) %}
			transport http {
				tls_insecure_skip_verify
			}
{% endif %}
{% if svc.host_header is defined %}
			header_up Host {{ svc.host_header }}
{% endif %}
		}
{% else %}
		reverse_proxy {{ svc.scheme | default('http') }}://{{ svc.backend }}
{% endif %}
	}

{% endfor %}
{% for name, app in download_apps | dictsort if app.proxy %}
	# --- {{ name }} (download catalog) ---
	@{{ name }} host {{ name }}.{{ service_domain }}
	handle @{{ name }} {
		reverse_proxy http://{{ hostvars[download_host].ansible_host }}:{{ app.ui_port }}
	}

{% endfor %}
	handle {
		abort
	}
}
