[Unit]
Description=Warn before the wildcard TLS certificate expires
# caddy.service: the check connects to Caddy on :443, so at boot it must not
# race Caddy's startup and alert on a listener that is merely not up yet.
After=network-online.target caddy.service
Wants=network-online.target

[Service]
Type=oneshot
# Type=oneshot disables the start timeout by default; see
# homelab-diskalert.service. A unit wedged in `activating` is not `failed`,
# so it alerts nobody.
TimeoutStartSec=300
ExecStart=/usr/local/sbin/homelab-certwatch.sh
