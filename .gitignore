# Secrets — the encrypted vault is technically safe to commit, but keeping it
# out entirely is the belt-and-suspenders default. Commit the .example only.
inventory/group_vars/all/vault.yml
.vault_pass

# Raw session transcripts — may contain decrypted variables or command output.
# Both names have been used locally; never commit either tree.
docs/sessions/
docs/transcripts/

# Fetched Caddy internal-CA roots (env-specific; regenerated per install)
*-root-ca.crt

# Python venv (created by `make deps`)
#
# No trailing slash, deliberately. A worktree starts without a .venv, and
# building a second one per worktree duplicates the collections tree for no
# benefit — so the practical move is to symlink it at the primary checkout's.
# `.venv/` matches a directory and NOT a symlink, so that symlink showed up as
# an untracked file, and step 5 of the change workflow requires
# `git status --porcelain` to print nothing. That made a worktree and a clean
# tree mutually exclusive, in exactly the parallel-work case the workflow says
# to use a worktree for.
#
# Symlinking is not optional either: tests/validate_secret_output.py resolves
# ROOT/.venv/bin/ansible-playbook directly and honours no override, so without
# a .venv at the worktree root that gate cannot run at all.
.venv
__pycache__/

# ruff writes this into the repo root on every run. The change workflow
# requires `git status --porcelain` to print nothing, so an un-ignored cache
# would fail the clean-tree check for a reason that is not a change.
.ruff_cache/
*.py[cod]

# Ansible cruft
*.retry
.ansible/
collections/ansible_collections/

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Git worktrees created inside the repo root. Step 5 of the change workflow
# requires `git status --porcelain` to print nothing, and untracked files
# count — so a worktree here makes the clean-tree check unsatisfiable while
# any parallel work is in flight, which is precisely when the workflow says
# to use one. Currently also listed in .git/info/exclude on this machine;
# that file is local-only and does not survive a clone, so it belongs here.
.claude/worktrees/

# Subagent-driven-development scratch: per-plan ledger, task briefs, reports and
# review packages. Same clean-tree reasoning as the worktree directory above —
# these are working artifacts of an in-flight change, and the git history is the
# durable record once the branch merges.
.superpowers/

# Editor / OS
*.swp
.DS_Store
.secrets/

# Working notes kept at the repo root deliberately: task lists, review output
# and session retrospectives. They are useful to have on disk next to the code,
# but they quote live credentials and raw command output (LLM-TODO-LIST.md
# holds the Beszel password in plaintext), so they must never be committed.
LLM-TODO-LIST.md
LLM-TODO-LIST-done-*.md
REVIEW-FINDINGS-*.md
SESSION-RETRO-*.md

# Local copies of live appdata backups (API keys, indexer creds, DB dumps)
# fetched from svc-download/svc-media for local restore convenience. These
# are the same artifacts backup-dl-appdata.service / backup-media.service
# produce on the VMs; never commit the actual archives.
local-backups/
