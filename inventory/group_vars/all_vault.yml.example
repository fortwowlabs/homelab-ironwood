---
# ============================================================================
# SECRETS. Copy to all/vault.yml (NOT group_vars/all_vault.yml — that name
# maps to a nonexistent group and is silently ignored) and encrypt:
#     cp inventory/group_vars/all_vault.yml.example inventory/group_vars/all/vault.yml
#     $EDITOR inventory/group_vars/all/vault.yml
#     ansible-vault encrypt inventory/group_vars/all/vault.yml
# Edit later with:  make vault-edit
# all/vault.yml is .gitignored; only the .example (this file) is committed.
# ============================================================================

# --- Proxmox API token (Phase 0 on thurgadin) — SCOPED (v5) ---------------
# v4 granted PVEVMAdmin at / with privilege separation disabled. v5 scopes
# the token to a pool holding only these two VMs + the two storages it
# actually touches, and keeps privsep ON (ACLs go on the token itself).
# Run ON thurgadin, once:
#
#   pveum pool add homelab-svc --comment "svc-download + svc-media"
#   pveum user add automation@pve
#   pveum user token add automation@pve ansible          # privsep stays 1
#   # VM lifecycle inside the pool only:
#   pveum aclmod /pool/homelab-svc -user automation@pve -role PVEVMAdmin
#   pveum aclmod /pool/homelab-svc -token 'automation@pve!ansible' -role PVEVMAdmin
#   # PVEVMAdmin does NOT include Pool.Audit, so /cluster/resources omits the
#   # `pool` field for this token even though it fully manages the VM through
#   # the pool ACL. roles/pve_vm's immutable-identity check on an EXISTING VM
#   # asserts pve_existing_vm.pool == pve_vm_pool, so without this grant that
#   # assertion always fails ('' != 'homelab-svc') the first time the role
#   # runs against an already-provisioned VM. PVEPoolUser is stock and is
#   # exactly Pool.Audit (no allocate/write capability) — grant it too:
#   pveum aclmod /pool/homelab-svc -user automation@pve -role PVEPoolUser
#   pveum aclmod /pool/homelab-svc -token 'automation@pve!ansible' -role PVEPoolUser
#   # Disk allocation on the VM storage + snippet/image storage:
#   pveum aclmod /storage/nvme0pool -user automation@pve -role PVEDatastoreUser
#   pveum aclmod /storage/nvme0pool -token 'automation@pve!ansible' -role PVEDatastoreUser
#   pveum aclmod /storage/local     -user automation@pve -role PVEDatastoreUser
#   pveum aclmod /storage/local     -token 'automation@pve!ansible' -role PVEDatastoreUser
#   # serial-port config is gated at / with Sys.Modify (PVE quirk); grant it
#   # via a single-privilege custom role, NOT PVEVMAdmin-at-/:
#   pveum role add homelab-sysmodify -privs Sys.Modify
#   pveum aclmod / -user automation@pve -role homelab-sysmodify
#   pveum aclmod / -token 'automation@pve!ansible' -role homelab-sysmodify
#   # PVE 8: NIC attachment needs SDN.Use on the bridge:
#   pveum role add homelab-sdnuse -privs SDN.Use
#   pveum aclmod /sdn/zones/localnetwork/vmbr0 -user automation@pve -role homelab-sdnuse
#   pveum aclmod /sdn/zones/localnetwork/vmbr0 -token 'automation@pve!ansible' -role homelab-sdnuse
#
# Honest scope note: the qm import / EFI-disk steps run as root over SSH
# anyway (module limitation), so this scoping protects against TOKEN leakage,
# not against compromise of the control node's SSH key. If the first create
# 403s on some edge permission, widen deliberately (add Sys.Audit on /nodes/
# thurgadin via a custom role) rather than reverting to PVEVMAdmin-at-/.
vault_pve_token_id:     "automation@pve!ansible"
vault_pve_token_secret: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- Mullvad WireGuard (from your generated config; wg(8) fields only) ---
vault_mullvad_privkey:    "REPLACE_base64_private_key"
vault_mullvad_peer_pubkey: "REPLACE_mullvad_server_public_key"
vault_mullvad_endpoint_ip: "185.x.x.x"      # NUMERIC endpoint IP
# Any port your generated config uses is fine now — v5 derives BOTH the
# nftables endpoint-IP set and the endpoint-PORT set from peer.conf, so the
# backstop no longer assumes 51820.
vault_mullvad_endpoint_port: 51820
vault_mullvad_wg_addr:    "10.65.x.x/32"     # your assigned tunnel Address

# (v6: the service VMs no longer run Tailscale — remote access is via a
# dedicated subnet-router VM — so there is no vault_tailscale_authkey here.)

# --- ntfy auth (only if your ntfy requires a token; else leave empty) ---
vault_ntfy_token: ""

# --- RomM (v6): DB creds + optional metadata providers -------------------
# DB_PASSWD in romm.env must equal MARIADB_PASSWORD in romm-db.env — both
# come from vault_romm_db_password. Adopting an already-running DB? set this
# to the CURRENT value, then rotate it inside MariaDB during maintenance.
# Never reset an initialized database directory during normal convergence.
vault_romm_db_password:      "REPLACE_db_password"
vault_romm_db_root_password: "REPLACE_db_root_password"
vault_romm_auth_secret_key:  "REPLACE_openssl_rand_hex_32"   # openssl rand -hex 32
# Metadata providers — all optional; leave "" to skip. Enrich ROMs you ingest.
vault_romm_igdb_client_id:      ""   # https://api-docs.igdb.com (Twitch app)
vault_romm_igdb_client_secret:  ""
vault_screenscraper_user:       ""
vault_screenscraper_password:   ""
vault_steamgriddb_api_key:      ""
vault_mobygames_api_key:        ""
vault_retroachievements_api_key: ""

# Cloudflare API token: Zone/DNS/Edit, scoped only to the fortwow.dev zone.
vault_cloudflare_api_token: "REPLACE_cloudflare_zone_dns_edit_token"

# Beszel monitoring (v6): the universal token and hub public key can only be
# generated by visiting the hub's own web UI once after it first deploys
# (Settings > Tokens for the universal token; the key is shown when adding a
# system) — there is no API/CLI path to generate them ahead of time.
# Deploying with these empty is fine: the hub comes up normally, agents on
# all three VMs skip themselves with a WARNING (matching the ntfy_url
# first-run pattern) until these are filled in and the deploy re-run. See
# docs/services.md "Beszel monitoring setup".
vault_beszel_token: ""
vault_beszel_key:   ""

# Paperless-ngx (v6): autogenerated Django secret key, plus the superuser
# created on first start by PAPERLESS_ADMIN_* (username "admin"). The admin
# password is only applied when no superuser exists yet — changing it later
# does not rotate an existing account.
vault_paperless_secret_key:    "REPLACE_openssl_rand_hex_32"   # openssl rand -hex 32
vault_paperless_admin_password: "REPLACE_openssl_rand_hex_24"  # openssl rand -hex 24

# Mealie (v6, infra_secret_apps): seeds the FIRST user via
# _DEFAULT_EMAIL/_DEFAULT_PASSWORD (login admin@<service_domain>). Without it
# Mealie seeds the well-known public default changeme@example.com/MyPassword.
# Applied only while the user table is empty.
vault_mealie_admin_password: "REPLACE_openssl_rand_hex_24"   # openssl rand -hex 24

# NetBox (v6): autogenerated secrets.
vault_netbox_db_password:        "REPLACE_openssl_rand_hex_24"   # openssl rand -hex 24
vault_netbox_secret_key:         "REPLACE_openssl_rand_hex_32"   # openssl rand -hex 32 (NetBox requires 50+ chars; hex32 is 64)
vault_netbox_redis_password:     "REPLACE_openssl_rand_hex_24"   # openssl rand -hex 24
vault_netbox_superuser_password: "REPLACE_openssl_rand_hex_16"   # openssl rand -hex 16

# Open WebUI (v6, infra_secret_apps): signs session JWTs. Open WebUI refuses
# to start with authentication enabled and no key set, and rotating it logs
# every user out — set once and leave it.
vault_openwebui_secret_key: "REPLACE_openssl_rand_hex_32"   # openssl rand -hex 32

# SearXNG (v6, download_apps): server.secret_key. Rendered into
# /srv/appdata/searxng/settings.yml rather than an Environment= line, because
# the download quadlet render is not no_log. The image's entrypoint would
# generate its own key, but only on a host with no settings.yml — pinning it
# here keeps sessions valid across a container rebuild.
vault_searxng_secret: "REPLACE_openssl_rand_hex_32"   # openssl rand -hex 32

# Immich (v6): autogenerated database password.
vault_immich_db_password: "REPLACE_openssl_rand_hex_24"   # openssl rand -hex 24

# Nextcloud (v6): database password + the non-interactive first-run admin
# account (NEXTCLOUD_ADMIN_USER is the literal "admin", set in the quadlet;
# only the password is a secret).
vault_nextcloud_db_password:    "REPLACE_openssl_rand_hex_24"   # openssl rand -hex 24
vault_nextcloud_admin_password: "REPLACE_openssl_rand_hex_24"   # openssl rand -hex 24

# code-server (v6, infra_secret_apps): autogenerated web-UI login password.
vault_codeserver_password: "REPLACE_openssl_rand_hex_24"   # openssl rand -hex 24

# Semaphore UI (v6, infra_secret_apps): admin password + the base64 key that
# encrypts the secrets Semaphore stores. The encryption key must stay stable
# across restarts or stored SSH keys/vault passwords become unreadable.
vault_semaphore_admin_password:        "REPLACE_openssl_rand_hex_24"      # openssl rand -hex 24
vault_semaphore_access_key_encryption: "REPLACE_openssl_rand_base64_32"   # openssl rand -base64 32

# Webtop (v6, infra_secret_apps): autogenerated HTTP basic-auth password.
vault_webtop_password: "REPLACE_openssl_rand_hex_24"   # openssl rand -hex 24

# Grafana (v6, infra_secret_apps): autogenerated admin login password.
vault_grafana_admin_password: "REPLACE_openssl_rand_hex_24"   # openssl rand -hex 24

# Vaultwarden (v6, infra_secret_apps): admin-panel credentials. Only the
# Argon2id PHC HASH is rendered into the Quadlet, so the plaintext never
# lands on disk outside this encrypted file — but the plaintext is what you
# actually type at /admin and cannot be recovered from the hash, so BOTH are
# kept here. The hash must use vaultwarden's "bitwarden" preset
# (argon2id, v=19, m=65536, t=3, p=4).
#
# The image's own `vaultwarden hash` tool needs a TTY and cannot be scripted,
# so generate both non-interactively instead — e.g. with argon2-cffi:
#   python -c 'import secrets;from argon2 import PasswordHasher,Type;\
#   p=secrets.token_hex(24);\
#   print(p, PasswordHasher(time_cost=3,memory_cost=65536,parallelism=4,\
#   hash_len=32,salt_len=16,type=Type.ID).hash(p))'
# Single-quote the PHC value in YAML: it contains $ and may contain +//=.
vault_vaultwarden_admin_token: "REPLACE_argon2id_phc_hash"        # the hash
vault_vaultwarden_admin_token_plaintext: "REPLACE_openssl_rand_hex_24"  # what you type at /admin

# Minecraft (v6, svc-media): shared RCON password for both LAN-only Paper
# servers (inventory/group_vars/all/minecraft.yml). RCON itself is never
# published or firewalled — this only gates `podman exec <name> rcon-cli`,
# run locally on svc-media for the nightly world-flush-before-tar and any
# ad-hoc admin (e.g. `whitelist add`).
vault_minecraft_rcon_password: "REPLACE_openssl_rand_hex_24"   # openssl rand -hex 24

# Authelia SSO (svc-infra). The first three are injected as Environment= lines
# by the infra_secret_apps catalog entry, keeping the rendered configuration
# file itself secret-free and diffable. NONE of them may be rotated casually:
#   session_secret         — rotating it invalidates every live session
#                            (everyone is logged out; harmless but noticed)
#   storage_encryption_key — rotating it makes the existing SQLite store
#                            UNREADABLE. Authelia will not start. Set once.
#   jwt_secret             — signs identity-validation (password reset) tokens
vault_authelia_session_secret:         "REPLACE_openssl_rand_hex_32"   # openssl rand -hex 32
vault_authelia_storage_encryption_key: "REPLACE_openssl_rand_hex_32"   # openssl rand -hex 32
vault_authelia_jwt_secret:             "REPLACE_openssl_rand_hex_32"   # openssl rand -hex 32

# The portal logins — one hash per account, keyed by the account's `name` in
# authelia_users (roles/svc_infra/defaults/main.yml). ONLY the hashes are
# secret: who exists and what group they are in is reviewable configuration
# and lives in git, not here.
#
# Every name in authelia_users needs a key in this dict. files.yml asserts
# that before rendering and names the ones it cannot find, because a missing
# key would otherwise produce an account that cannot log in on a deploy that
# reported success. A value that is not an argon2 PHC string — a plaintext
# password pasted in by mistake — counts as missing for the same reason.
#
# Unlike the three secrets above, these go into a file rather than an
# Environment= line, so their $ signs need no escaping — single-quote them.
#
# Generate with Authelia's own CLI (argon2id, its defaults: t=3, m=65536,
# p=4, 32-byte hash, 16-byte salt):
#   podman run --rm ghcr.io/authelia/authelia@sha256:1b363e9279e742397966333f364e0876ae02bf5c876de73e83af6d48c57ff51b \
#     authelia crypto hash generate argon2 --password '<password>'
# or non-interactively with argon2-cffi, matching those parameters:
#   python -c 'import secrets;from argon2 import PasswordHasher,Type;\
#   p=secrets.token_urlsafe(24);\
#   print(p, PasswordHasher(time_cost=3,memory_cost=65536,parallelism=4,\
#   hash_len=32,salt_len=16,type=Type.ID).hash(p))'
#
# Password changes belong HERE, not in the portal UI: Authelia rewrites
# users.yml itself on a UI change and the next deploy would revert it. There
# is no SMTP in this estate and password_reset is disabled, so there is no
# self-service path either — every change is a vault edit plus a deploy.
vault_authelia_password_hashes:
  admin:   "REPLACE_argon2id_phc_hash"
  brandon: "REPLACE_argon2id_phc_hash"
  valerie: "REPLACE_argon2id_phc_hash"
  michael: "REPLACE_argon2id_phc_hash"
  erin:    "REPLACE_argon2id_phc_hash"
  guest:   "REPLACE_argon2id_phc_hash"

# The plaintexts, kept beside the hashes for the same reason as the
# vaultwarden pair above: they are what gets typed at https://auth.<domain>
# and cannot be recovered from a hash. Nothing templates these — they exist so
# handing someone their password later does not mean resetting it. Vaultwarden
# is the better place to share them from once the account is handed over.
vault_authelia_password_plaintexts:
  admin:   "REPLACE_openssl_rand_hex_24"
  brandon: "REPLACE_openssl_rand_hex_24"
  valerie: "REPLACE_openssl_rand_hex_24"
  michael: "REPLACE_openssl_rand_hex_24"
  erin:    "REPLACE_openssl_rand_hex_24"
  guest:   "REPLACE_openssl_rand_hex_24"

# --- healthchecks.io: the dead-man's switch ------------------------------
# Everything else in this repo alerts by pushing to ntfy. That cannot tell
# you about the one failure that matters most while you are away: the whole
# environment (or ntfy itself, or the house's power) being gone. Silence and
# health look identical from a phone.
#
# healthchecks.io inverts it: these jobs ping OUT on success, and if a ping
# does not arrive within its grace period, healthchecks.io — running on
# somebody else's infrastructure — emails and pushes you.
#
# ONE-TIME SETUP (nothing automates this; the account is yours):
#   1. Sign up at https://healthchecks.io (free tier covers 20 checks).
#   2. Add its notification channels FIRST — email plus a phone push. A
#      check with no channel fails silently, which defeats the point.
#   3. Create the five checks below with the listed period/grace.
#   4. Copy each check's ping UUID (the last path element of its ping URL,
#      NOT the whole URL) into vault.yml with `make vault-edit`.
#
# Leaving a UUID empty is safe and supported: the job skips its ping and
# says so in the journal. That is the state a fresh clone deploys in.
#
#   check name          period / grace   pinged by
#   homelab-verify      1 day  / 6 h     nightly verify on svc-infra
#   homelab-backups     1 day  / 6 h     backups-fresh check on svc-infra
#   homelab-pve         1 day  / 6 h     daily health check on the PVE host
#   homelab-heartbeat   1 day  / 3 h     svc-media (proves the ntfy host lives)
#
# There is deliberately no separate scrub check: PVE already scrubs monthly
# from /etc/cron.d/zfsutils-linux, and homelab-pve-health fails if the last
# completed scrub is older than 45 days. A second scrub timer would double
# the I/O to learn the same thing.
vault_hc_ping_verify:    ""   # UUID only, e.g. 1a2b3c4d-....  Empty = disabled.
vault_hc_ping_backups:   ""
vault_hc_ping_pve:       ""
vault_hc_ping_heartbeat: ""
